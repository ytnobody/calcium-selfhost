// compiler - AST to bytecode.
//
// A pure state machine: the constant pool, the instruction stream and the global
// symbol table are threaded through every function instead of being mutated.
//
// This is the first slice: literals, identifiers, member access, calls and the
// effect pipe — enough to compile and run
//
//	use core.io!;
//	"hi" !> io.say;
//
// The emitted instructions follow the reference implementation's conventions so
// that the resulting .bone runs unchanged on the reference VM.

namespace compiler;

// implemented reports to the differential harness whether this component exists.
func implemented() = true;

use core.array;
use core.string;
use core.types;
use ast;
use bytecode;
use serialize;

// A state record holds everything the compiler accumulates.
//   code     instruction bytes
//   consts   constant pool (serialize.Constant values)
//   globals  [{name, index}] for global symbols
//   nglobals next free global index
// A state record holds everything the compiler accumulates.
//   code      instruction bytes
//   consts    constant pool (serialize.Constant values)
//   globals   [{name, index}] for global symbols
//   nglobals  next free global index
//   locals    [{name, index}] for the function being compiled
//   nlocals   next free local index
//   free          [{name, index}] captured from the enclosing function
//   outer_locals  the enclosing function's locals, used to detect captures
//   outer_free    the enclosing function's own captures (passed through)
//   errors        compile-time diagnostics: [{line, col, message}]
func new_state() = {
    code: [], consts: [], globals: [], nglobals: 0,
    locals: [], nlocals: 0, free: [], outer_locals: [], outer_free: [], in_fn: false,
    errors: []
};

// add_error records a diagnostic. Compilation continues so that one run reports as
// many problems as possible, exactly like a compiler that collects errors.
func add_error(st, line, col, message) =
    with_errors_list(st, push(st.errors, {line: line, col: col, message: message}));

func with_errors_list(st, errors) = {
    code: st.code, consts: st.consts, globals: st.globals, nglobals: st.nglobals,
    locals: st.locals, nlocals: st.nlocals, free: st.free,
    outer_locals: st.outer_locals, outer_free: st.outer_free, in_fn: st.in_fn,
    errors: errors
};

// with_fresh_locals starts a new function body: parameters become locals 0..n-1.
// The instruction stream starts empty — a function's body is its own record — while
// the constant pool stays shared with the program.
func with_fresh_locals(st, params) = {
    code: [], consts: st.consts, globals: st.globals, nglobals: st.nglobals,
    locals: params_locals(params, 0, len(params), []), nlocals: len(params),
    free: [], outer_locals: st.locals, outer_free: st.free, in_fn: true,
    errors: st.errors
};

// with_lambda starts a closure's own instruction stream. Constants stay shared
// with the enclosing program, which is what the format requires.
func with_lambda(st, params) = {
    code: [], consts: st.consts, globals: st.globals, nglobals: st.nglobals,
    locals: params_locals(params, 0, len(params), []), nlocals: len(params),
    free: [], outer_locals: st.locals, outer_free: st.free, in_fn: true,
    errors: st.errors
};

func with_free(st, free) = rebuild(st, st.code, st.consts, st.globals, st.nglobals,
    st.locals, st.nlocals, free, st.outer_locals, st.outer_free);

func rebuild(st, code, consts, globals, nglobals, locals, nlocals, free, outer_locals, outer_free) = {
    code: code, consts: consts, globals: globals, nglobals: nglobals,
    locals: locals, nlocals: nlocals, free: free,
    outer_locals: outer_locals, outer_free: outer_free, in_fn: st.in_fn,
    errors: st.errors
};

func params_locals(params, i, n, acc) = match i >= n
    true => acc
    false => params_locals(params, i + 1, n, push(acc, {name: params[i], index: i}));

func define_local(st, name) = rebuild(st, st.code, st.consts, st.globals, st.nglobals,
    push(st.locals, {name: name, index: st.nlocals}), st.nlocals + 1,
    st.free, st.outer_locals, st.outer_free);

// ---------------------------------------------------------------------------
// Emitting
// ---------------------------------------------------------------------------

func emit(st, bytes) = with_code(st, concat_arr(st.code, bytes));

func with_code(st, code) = rebuild(st, code, st.consts, st.globals, st.nglobals,
    st.locals, st.nlocals, st.free, st.outer_locals, st.outer_free);

func with_consts(st, consts) = rebuild(st, st.code, consts, st.globals, st.nglobals,
    st.locals, st.nlocals, st.free, st.outer_locals, st.outer_free);

func with_globals(st, globals, nglobals) = rebuild(st, st.code, st.consts,
    globals, nglobals, st.locals, st.nlocals, st.free, st.outer_locals, st.outer_free);

// add_constant appends a constant and returns its index and the new state.
func add_constant(st, c) = {index: len(st.consts), st: with_consts(st, push(st.consts, c))};

func concat_arr(a, b) = append_into(copy_arr(a, 0, len(a), []), b, 0, len(b));

func copy_arr(a, i, n, acc) = match i >= n
    true => acc
    false => copy_arr(a, i + 1, n, push(acc, a[i]));

func append_into(acc, b, i, n) = match i >= n
    true => acc
    false => append_into(push(acc, b[i]), b, i + 1, n);

// ---------------------------------------------------------------------------
// Symbols
//
// A flat association list is enough: programs have tens of globals, and lookup
// happens once per identifier.
// ---------------------------------------------------------------------------

func find_global(globals, name, i, n) = match i >= n
    true => Maybe.None
    false => find_global_1(globals, name, i, n);

func find_global_1(globals, name, i, n) = match globals[i].name == name
    true => Maybe.Some(globals[i].index)
    false => find_global(globals, name, i + 1, n);

func define_global(st, name) = match find_global(st.globals, name, 0, len(st.globals))
    Maybe.Some(index) => {index: index, st: st}
    Maybe.None => {index: st.nglobals, st: with_globals(st, push(st.globals, {name: name, index: st.nglobals}), st.nglobals + 1)};

// ---------------------------------------------------------------------------
// Program
// ---------------------------------------------------------------------------

// compile_program declares every top-level name before compiling any body, so a
// function can refer to itself and to functions defined later.
func compile_program(statements) = do
    declared = predeclare(new_state(), statements, 0, len(statements));
    compile_statements(declared, statements, 0, len(statements))
end;

func predeclare(st, ss, i, n) = match i >= n
    true => st
    false => predeclare(predeclare_stmt(st, ss[i]), ss, i + 1, n);

func predeclare_stmt(st, stmt) = match stmt
    Stmt.SFunc(name, params, cons, types, rc, body, eff) => define_global(st, name).st
    Stmt.SConstraint(name, params, body) => define_global(st, name).st
    Stmt.SType(name, variants) => predeclare_variants(st, variants, 0, len(variants))
    _ => st;

func predeclare_variants(st, vs, i, n) = match i >= n
    true => st
    false => predeclare_variants(predeclare_variant(st, vs[i]), vs, i + 1, n);

func predeclare_variant(st, v) = match v
    Variant.Variant(name, fields) => define_global(st, name).st
    _ => st;

func compile_statements(st, ss, i, n) = match i >= n
    true => st
    false => compile_statements(compile_statement(st, ss[i]), ss, i + 1, n);

func compile_statement(st, stmt) = match stmt
    Stmt.SUse(path, effect) => compile_use(st, path)
    Stmt.SExpr(e) => compile_expr_statement(st, e)
    Stmt.SFunc(name, params, constraints, types, rc, body, is_effect) => compile_function(st, name, params, effective_constraints(constraints, types), rc, is_effect, body)
    Stmt.SAssign(name, value) => compile_assign(st, name, value)
    Stmt.SType(name, variants) => compile_variants(st, name, variants, 0, len(variants))
    Stmt.SConstraint(name, params, body) => compile_function(st, name, params, [], no_annotation(), false, body)
    _ => st;

// A function declaration compiles its body into a FunctionRecord constant and
// leaves a closure for it in a global.
func compile_function(st, name, params, constraints, return_annot, is_effect, body) = do
    return_constraint = annotation_name(return_annot);
    inner = with_fresh_locals(st, params);
    guarded = emit_param_checks(inner, params, constraints, 0);
    compiled = compile_checked_body(guarded, body, constraints, return_constraint, is_effect);

    record = serialize.FunctionRecord(name, "entry", params, compiled.st.nlocals, is_effect, compiled.st.code);
    listed = add_constant(with_consts(st, compiled.st.consts), serialize.CFunc(record));
    loaded = load_captures(listed.st, compiled.st.free, 0, len(compiled.st.free));
    st2 = emit(loaded, bytecode.ins_u16_u8(bytecode.closure(), listed.index, len(compiled.st.free)));
    defined = define_global(st2, name);
    emit(defined.st, bytecode.ins_u16(bytecode.set_global(), defined.index))
end;

// A lambda becomes a function constant plus OpClosure. Values it captures are
// pushed by the enclosing function first, in capture order.
func compile_lambda(st, params, body) = do
    inner = with_lambda(st, params);
    compiled = compile_body(inner, body);
    record = serialize.FunctionRecord("", "entry", params, compiled.st.nlocals, false, compiled.st.code);
    listed = add_constant(with_consts(st, compiled.st.consts), serialize.CFunc(record));
    loaded = load_captures(listed.st, compiled.st.free, 0, len(compiled.st.free));
    {e: ast.EWild, st: emit(loaded, bytecode.ins_u16_u8(bytecode.closure(), listed.index, len(compiled.st.free)))}
end;

func load_captures(st, frees, i, n) = match i >= n
    true => st
    false => load_captures(load_capture(st, frees[i].name), frees, i + 1, n);

func load_capture(st, name) = match find_local(st.locals, name, 0, len(st.locals))
    Maybe.Some(index) => emit(st, bytecode.ins_u8(bytecode.get_local(), index))
    Maybe.None => load_capture_outer(st, name);

func load_capture_outer(st, name) = match find_local(st.free, name, 0, len(st.free))
    Maybe.Some(index) => emit(st, bytecode.ins_u8(bytecode.get_free(), index))
    Maybe.None => emit_global_load(st, name);

func emit_global_load(st, name) = match find_global(st.globals, name, 0, len(st.globals))
    Maybe.Some(index) => emit(st, bytecode.ins_u16(bytecode.get_global(), index))
    Maybe.None => st;

// effective_constraints merges the two annotation arrays: an explicit constraint
// wins, otherwise a built-in type annotation is enforced as one (which is what
// the reference compiler does, even though the formatter does not print it).
func effective_constraints(constraints, types) = merge_constraints(constraints, types, 0, len(constraints), []);

func merge_constraints(constraints, types, i, n, acc) = match i >= n
    true => acc
    false => merge_constraints(constraints, types, i + 1, n, push(acc, merge_one(constraint_at(constraints, i), constraint_at(types, i))));

func merge_one(c, ty) = match c == ""
    true => annotation_name(ty)
    false => c;

// annotation_name reads the name out of an annotation record; "" means none.
func annotation_name(a) = a.name;

func no_annotation() = {name: "", line: 0, col: 0};

func constraint_at(cs, i) = match i < len(cs)
    true => cs[i]
    false => "";

func has_constraints(constraints) = any_constraint(constraints, 0, len(constraints));

func any_constraint(cs, i, n) = match i >= n
    true => false
    false => match cs[i] == ""
        true => any_constraint(cs, i + 1, n)
        false => true;

// A constrained parameter is checked on entry; a violation returns
// failure(value) instead of running the body.
func emit_param_checks(st, params, constraints, i) = match i >= len(params)
    true => st
    false => match constraint_at(constraints, i) == ""
        true => emit_param_checks(st, params, constraints, i + 1)
        false => emit_param_checks(emit_param_check(st, i, constraint_at(constraints, i)), params, constraints, i + 1);

func emit_param_check(st, i, name) = do
    s1 = emit(st, bytecode.ins_u8(bytecode.get_local(), i));
    s2 = compile_callee(s1, ast.EIdent(name)).st;
    s3 = emit(s2, bytecode.ins_u8(bytecode.get_local(), i));
    s4 = emit(s3, bytecode.ins_u8(bytecode.call(), 1));
    jump_pos = len(s4.code);
    s5 = emit(s4, bytecode.ins_u16(bytecode.jump_if_true(), 0));
    s6 = emit(s5, bytecode.ins(bytecode.pop()));
    s7 = emit(s6, bytecode.ins_u8(bytecode.get_local(), i));
    s8 = emit(s7, bytecode.ins(bytecode.wrap_failure()));
    s9 = emit(s8, bytecode.ins(bytecode.ret()));
    s10 = patch_u16(s9, jump_pos, len(s9.code));
    emit(s10, bytecode.ins(bytecode.pop()))
end;

// compile_checked_body finishes a function body: it applies the return
// constraint, wraps the result in success when the function is an effect
// function or has any constraint, and returns.
//
// A tail call is only marked when no return check follows it; otherwise the check
// would be skipped.
func compile_checked_body(st, body, constraints, return_constraint, is_effect) = do
    r = compile_expr(st, body);
    tailed = match return_constraint == ""
        true => mark_tail(r.st)
        false => r.st;
    checked = emit_return_check(tailed, return_constraint);
    wrapped = match is_effect || has_constraints(constraints) || return_constraint != ""
        true => emit(checked, bytecode.ins(bytecode.wrap_success()))
        false => checked;
    {e: ast.EWild, st: emit(wrapped, bytecode.ins(bytecode.ret()))}
end;

// emit_return_check runs the return constraint against the value on the stack:
// a violation returns failure(value) instead of success(value).
func emit_return_check(st, rc) = match rc == "" || !is_resolvable(st, rc)
    true => st
    false => do
        st2 = define_local(st, "__return__");
        tmp = st2.nlocals - 1;
        s1 = emit(st2, bytecode.ins_u8(bytecode.set_local(), tmp));
        s2 = compile_callee(s1, ast.EIdent(rc)).st;
        s3 = emit(s2, bytecode.ins_u8(bytecode.get_local(), tmp));
        s4 = emit(s3, bytecode.ins_u8(bytecode.call(), 1));
        jump_pos = len(s4.code);
        s5 = emit(s4, bytecode.ins_u16(bytecode.jump_if_true(), 0));
        s6 = emit(s5, bytecode.ins_u8(bytecode.get_local(), tmp));
        s7 = emit(s6, bytecode.ins(bytecode.wrap_failure()));
        s8 = emit(s7, bytecode.ins(bytecode.ret()));
        s9 = patch_u16(s8, jump_pos, len(s8.code));
        emit(s9, bytecode.ins_u8(bytecode.get_local(), tmp))
    end;

// is_resolvable reports whether a name is a builtin or a declared global, which
// is what makes a return annotation enforceable.
func is_resolvable(st, name) = match builtin_index(ast.EIdent(name))
    Maybe.Some(_) => true
    Maybe.None => find_global_any(st, name);

func find_global_any(st, name) = match find_global(st.globals, name, 0, len(st.globals))
    Maybe.Some(_) => true
    Maybe.None => false;

// compile_body_wrapped finishes a function body, wrapping the result in success
// when the function has constraints (which makes it return a Result).
func compile_body_wrapped(st, body, wrapped) = do
    r = compile_expr(st, body);
    tailed = mark_tail(r.st);
    w = match wrapped
        true => emit(tailed, bytecode.ins(bytecode.wrap_success()))
        false => tailed;
    {e: ast.EWild, st: emit(w, bytecode.ins(bytecode.ret()))}
end;

func compile_body(st, body) = do
    r = compile_expr(st, body);
    tailed = mark_tail(r.st);
    {e: ast.EWild, st: emit(tailed, bytecode.ins(bytecode.ret()))}
end;

// mark_tail rewrites a trailing OpCall into OpTailCall. A call in tail position
// must reuse the frame, otherwise a deep recursion grows the stack to the frame
// limit. OpCall is two bytes (opcode + argument count), so the opcode to rewrite
// sits at len-2.
func mark_tail(st) = match len(st.code) >= 2 && st.code[len(st.code) - 2] == bytecode.call()
    true => with_code(st, replace_range(st.code, len(st.code) - 2, [bytecode.tail_call()]))
    false => st;

// A top-level assignment binds a global; inside a function it binds a local, as
// the reference does. Variables are immutable, so a name is bound once.
func compile_assign(st, name, value) = do
    r = compile_expr(st, value);
    match r.st.in_fn
        true => define_local_assign(r.st, name)
        false => define_global_assign(r.st, name)
end;

func define_local_assign(st, name) = do
    st2 = define_local(st, name);
    index = st2.nlocals - 1;
    emit(st2, bytecode.ins_u8(bytecode.set_local(), index))
end;

func define_global_assign(st, name) = do
    defined = define_global(st, name);
    emit(defined.st, bytecode.ins_u16(bytecode.set_global(), defined.index))
end;

// A `type` declaration binds one constructor per variant: a constant for a
// zero-argument variant, a function otherwise.
func compile_variants(st, type_name, variants, i, n) = match i >= n
    true => st
    false => compile_variants(compile_variant(st, type_name, variants[i]), type_name, variants, i + 1, n);

func compile_variant(st, type_name, v) = match v
    Variant.Variant(name, fields) => compile_variant_of(st, type_name, name, fields)
    _ => st;

func compile_variant_of(st, type_name, name, fields) = match len(fields) == 0
    true => compile_nullary_ctor(st, type_name, name)
    false => compile_ctor_fn(st, type_name, name, fields);

func compile_nullary_ctor(st, type_name, name) = do
    added = add_constant(st, serialize.CAdt(type_name, name, []));
    s1 = emit(added.st, bytecode.ins_u16(bytecode.constant(), added.index));
    defined = define_global(s1, name);
    emit(defined.st, bytecode.ins_u16(bytecode.set_global(), defined.index))
end;

func compile_ctor_fn(st, type_name, name, fields) = do
    tag_added = add_constant(st, serialize.CStr(concat(type_name, ".", name)));
    body = concat_arr(bytecode.ins_u16_u8(bytecode.construct_adt(), tag_added.index, len(fields)),
        bytecode.ins(bytecode.ret()));
    record = serialize.FunctionRecord(name, "entry", fields, len(fields), false, body);
    listed = add_constant(tag_added.st, serialize.CFunc(record));
    s1 = emit(listed.st, bytecode.ins_u16_u8(bytecode.closure(), listed.index, 0));
    defined = define_global(s1, name);
    emit(defined.st, bytecode.ins_u16(bytecode.set_global(), defined.index))
end;

func compile_use(st, path) = do
    added = add_constant(st, serialize.CStr(path));
    st2 = emit(added.st, bytecode.ins_u16(bytecode.load_module(), added.index));
    name = module_name(path);
    defined = define_global(st2, name);
    emit(defined.st, bytecode.ins_u16(bytecode.set_global(), defined.index))
end;

// module_name is the last dotted component: `core.io` binds as `io`.
func module_name(path) = module_name_from(string.split(path, "."), 0, len(string.split(path, ".")), "");

func module_name_from(parts, i, n, acc) = match i >= n
    true => acc
    false => module_name_from(parts, i + 1, n, parts[i]);

// compile_expr_strict compiles an expression and keeps only the state; the
// node field of the result record is not used by the caller.
func compile_expr_strict(st, e) = compile_expr(st, e).st;

func compile_expr_statement(st, e) = do
    r = compile_expr(st, e);
    emit(r.st, bytecode.ins(bytecode.pop()))
end;

// ---------------------------------------------------------------------------
// Expressions
// ---------------------------------------------------------------------------

func compile_expr(st, e) = match e
    Expr.EStr(value) => compile_const(st, serialize.CStr(value))
    Expr.EInt(raw) => compile_const(st, serialize.CInt(parse_int(raw)))
    Expr.EFloat(raw) => compile_const(st, serialize.CFloat(parse_float(raw)))
    Expr.EBool(value) => compile_bool(st, value)
    Expr.EIdent(name) => compile_ident(st, name)
    Expr.EMember(object, property) => compile_member(st, object, property)
    Expr.EEffectPipe(left, right, secret) => compile_effect_pipe(st, left, right)
    Expr.EPipe(left, right) => compile_pipe(st, left, right)
    Expr.EInfix(op, left, right) => compile_infix(st, op, left, right)
    Expr.EArray(elements, is_concat) => compile_array(st, elements, is_concat)
    Expr.ETuple(elements) => compile_tuple(st, elements)
    Expr.EIndex(left, index) => compile_index(st, left, index)
    Expr.EPrefix(op, right) => compile_prefix(st, op, right)
    Expr.ESuccess(value) => compile_success(st, value)
    Expr.EFailure(value) => compile_failure(st, value)
    Expr.EReturn(value) => compile_return(st, value)
    Expr.ERegex(text) => compile_regex(st, text)
    Expr.EConstraintCheck(target) => compile_constraint_check(st, target)
    Expr.EStay(state_init, body) => compile_stay(st, state_init, body)
    Expr.EEffectHandle(subject, sv, sb, fv, fb) => compile_handler(st, subject, sv, sb, fv, fb)
    Expr.EHash(pairs) => compile_hash(st, pairs)
    Expr.ELambda(params, body) => compile_lambda(st, params, body)
    Expr.EMatch(subject, cases) => compile_match(st, subject, cases)
    Expr.ECall(fn, args) => compile_call_or_builtin(st, fn, args)
    Expr.EDo(statements, final) => compile_do(st, statements, final)
    Expr.EInterp(parts) => compile_interp(st, parts, 0, len(parts))
    Expr.ESpread(value) => compile_spread(st, value)
    Expr.EWild => {e: ast.EWild, st: emit(st, bytecode.ins(bytecode.true_()))}
    _ => {e: ast.EWild, st: st};

// A do block evaluates its statements for their effects and yields the final
// expression. Statements other than the last are popped; the last statement of
// the source is the block's value, so it inherits the block's tail position (a
// trailing call still becomes OpTailCall through mark_tail).
func compile_do(st, statements, final) = do
    r = compile_statements(st, statements, 0, len(statements));
    compile_expr(r, final)
end;

// An interpolated string is a concatenation of its parts; OpAdd converts the
// non-string parts, which is what the reference VM does.
func compile_interp(st, parts, i, n) = match i >= n
    true => {e: ast.EWild, st: st}
    false => concat_parts(compile_expr(st, parts[i]), parts, i, n);

func concat_parts(r, parts, i, n) = match i == 0
    true => compile_interp(r.st, parts, i + 1, n)
    false => concat_parts(emit2(r.st), parts, i + 1, n);

func emit2(st) = emit(st, bytecode.ins(bytecode.add()));

// A spread argument collects the array into the call's argument list.
func compile_spread(st, value) = do
    r = compile_expr(st, value);
    {e: ast.EWild, st: emit(r.st, bytecode.ins(bytecode.spread()))}
end;

// parse_int handles decimal and 0x/0b literals. Digit separators are removed
// first, and a non-decimal literal is converted through its digits because
// types.to_int only parses decimal text.
func parse_int(raw) = parse_int_clean(remove_underscores(raw, 0, len(raw), ""));

func remove_underscores(s, i, n, acc) = match i >= n
    true => acc
    false => remove_underscores_1(s, i, n, acc, string.char_at(s, i));

func remove_underscores_1(s, i, n, acc, ch) = match ch
    Maybe.Some(c) => remove_underscores(s, i + 1, n, match c == "_"
        true => acc
        false => concat(acc, c))
    Maybe.None => acc;

// parse_float reads the source text of a float literal.
func parse_float(raw) = types.to_float(remove_underscores(raw, 0, len(raw), "")) !? {
    success(v) => v
    failure(e) => 0.0
};

func parse_int_clean(s) = match string.starts_with(s, "0x") || string.starts_with(s, "0X")
    true => parse_radix(string.substring_from(s, 2), 16, 0, 0)
    false => parse_int_dec(s);

func parse_int_dec(s) = match string.starts_with(s, "0b") || string.starts_with(s, "0B")
    true => parse_radix(string.substring_from(s, 2), 2, 0, 0)
    false => types.to_int(s) !? {
        success(v) => v
        failure(e) => 0
    };

// parse_radix converts a run of digits in the given base to an integer.
func parse_radix(s, base, i, acc) = match i >= string.length(s)
    true => acc
    false => parse_radix(s, base, i + 1, acc * base + digit_value(s, i));

func digit_value(s, i) = digit_of(string.char_at(s, i));

func digit_of(ch) = match ch
    Maybe.Some("0") => 0
    Maybe.Some("1") => 1
    Maybe.Some("2") => 2
    Maybe.Some("3") => 3
    Maybe.Some("4") => 4
    Maybe.Some("5") => 5
    Maybe.Some("6") => 6
    Maybe.Some("7") => 7
    Maybe.Some("8") => 8
    Maybe.Some("9") => 9
    Maybe.Some("a") => 10
    Maybe.Some("b") => 11
    Maybe.Some("c") => 12
    Maybe.Some("d") => 13
    Maybe.Some("e") => 14
    Maybe.Some("f") => 15
    Maybe.Some("A") => 10
    Maybe.Some("B") => 11
    Maybe.Some("C") => 12
    Maybe.Some("D") => 13
    Maybe.Some("E") => 14
    Maybe.Some("F") => 15
    _ => 0;

func compile_const(st, c) = do
    added = add_constant(st, c);
    {e: ast.EWild, st: emit(added.st, bytecode.ins_u16(bytecode.constant(), added.index))}
end;

func compile_bool(st, value) = match value
    true => {e: ast.EWild, st: emit(st, bytecode.ins(bytecode.true_()))}
    false => {e: ast.EWild, st: emit(st, bytecode.ins(bytecode.false_()))};

func compile_ident(st, name) = match find_local(st.locals, name, 0, len(st.locals))
    Maybe.Some(index) => {e: ast.EWild, st: emit(st, bytecode.ins_u8(bytecode.get_local(), index))}
    Maybe.None => compile_captured(st, name);

// A name that is not local but exists in the enclosing function is a capture:
// it becomes a free variable of this closure.
func compile_captured(st, name) = match find_local(st.outer_locals, name, 0, len(st.outer_locals))
    Maybe.Some(_) => do
        f = capture(st, name);
        {e: ast.EWild, st: emit(f.st, bytecode.ins_u8(bytecode.get_free(), f.index))}
    end
    Maybe.None => compile_global(st, name);

func capture(st, name) = match find_local(st.free, name, 0, len(st.free))
    Maybe.Some(index) => {index: index, st: st}
    Maybe.None => {index: len(st.free), st: with_free(st, push(st.free, {name: name, index: len(st.free)}))};

func compile_global(st, name) = match find_global(st.globals, name, 0, len(st.globals))
    Maybe.Some(index) => {e: ast.EWild, st: emit(st, bytecode.ins_u16(bytecode.get_global(), index))}
    Maybe.None => compile_builtin_value(st, name);

// A builtin used as a value rather than called: `Function(len)`.
func compile_builtin_value(st, name) = match builtin_index(ast.EIdent(name))
    Maybe.Some(index) => {e: ast.EWild, st: emit(st, bytecode.ins_u8(bytecode.builtin(), index))}
    Maybe.None => {e: ast.EWild, st: st};

func find_local(locals, name, i, n) = match i >= n
    true => Maybe.None
    false => find_local_1(locals, name, i, n);

func find_local_1(locals, name, i, n) = match locals[i].name == name
    true => Maybe.Some(locals[i].index)
    false => find_local(locals, name, i + 1, n);

// `Maybe.Some` and `Maybe.None` are built-in constructors, not module members:
// Some is a function that emits OpConstructMaybeSome, None is a constant.
func compile_member(st, object, property) = match is_maybe(object)
    true => compile_maybe_member(st, property)
    false => compile_member_access(st, object, property);

func is_maybe(object) = match object
    Expr.EIdent(name) => name == "Maybe"
    _ => false;

func compile_maybe_member(st, property) = match property
    "None" => compile_const(st, serialize.CAdt("Maybe", "Maybe.None", []))
    "Some" => compile_const(st, serialize.CFunc(maybe_some_record()))
    _ => compile_member_access(st, ast.EIdent("Maybe"), property);

func maybe_some_record() = serialize.FunctionRecord("Some", "entry", ["value"], 1, false,
    concat_arr(bytecode.ins(bytecode.construct_maybe_some()), bytecode.ins(bytecode.ret())));

func compile_member_access(st, object, property) = do
    obj = compile_expr(st, object);
    added = add_constant(obj.st, serialize.CStr(property));
    {e: ast.EWild, st: emit(added.st, bytecode.ins_u16(bytecode.get_member(), added.index))}
end;

func compile_call(st, fn, args) = do
    f = compile_callee(st, fn);
    a = compile_args(f.st, args, 0, len(args));
    {e: ast.EWild, st: emit(a, bytecode.ins_u8(bytecode.call(), len(args)))}
end;

func compile_args(st, args, i, n) = match i >= n
    true => st
    false => compile_args(compile_expr(st, args[i]).st, args, i + 1, n);

// `x |> f(y)` is `f(x, y)`: the piped value becomes the *first* argument. For a
// bare `x |> f` it is `f(x)`. The callee is pushed first because the VM looks
// for it at sp-1-numArgs.
func compile_pipe(st, left, right) = match right
    Expr.ECall(fn, args) => compile_pipe_call(st, left, fn, args)
    Expr.EConstraintCheck(target) => compile_pipe_constraint(st, left, target)
    _ => do
        r = compile_callee(st, right);
        l = compile_expr(r.st, left);
        {e: ast.EWild, st: emit(l.st, bytecode.ins_u8(bytecode.call(), 1))}
    end;

// `value |> Constraint?` pushes the value, the constraint, the value again, calls
// the constraint and wraps the result in success/failure.
func compile_pipe_constraint(st, left, target) = do
    s1 = compile_expr_strict(st, left);
    s2 = compile_callee(s1, target).st;
    s3 = compile_expr_strict(s2, left);
    s4 = emit(s3, bytecode.ins_u8(bytecode.call(), 1));
    {e: ast.EWild, st: emit(s4, bytecode.ins(bytecode.check_constraint()))}
end;

func compile_pipe_call(st, left, fn, args) = do
    f = compile_callee(st, fn);
    l = compile_expr(f.st, left);
    a = compile_args(l.st, args, 0, len(args));
    {e: ast.EWild, st: emit(a, bytecode.ins_u8(bytecode.call(), 1 + len(args)))}
end;

func compile_effect_pipe(st, left, right) = compile_pipe(st, left, right);

// compile_callee pushes a callable: a builtin by index, or an ordinary
// expression (a global, a local, a capture, or a member).
func compile_callee(st, fn) = match builtin_index(fn)
    Maybe.Some(index) => {e: ast.EWild, st: emit(st, bytecode.ins_u8(bytecode.builtin(), index))}
    Maybe.None => compile_expr(st, fn);

// An array literal pushes its elements then OpArray with the count.
func compile_array(st, elements, is_concat) = do
    s1 = compile_args(st, elements, 0, len(elements));
    op = match is_concat
        true => bytecode.array_concat()
        false => bytecode.array();
    {e: ast.EWild, st: emit(s1, bytecode.ins_u16(op, len(elements)))}
end;

// async.stay(name: value, ...) { body }: push the initial state as key/value
// pairs, OpStayBegin, the body statements, then OpStayEnd.
func compile_stay(st, state_init, body) = do
    s1 = push_state(st, state_init, 0, len(state_init));
    s2 = emit(s1, bytecode.ins_u16(bytecode.stay_begin(), len(state_init)));
    s3 = compile_statements(s2, body, 0, len(body));
    {e: ast.EWild, st: emit(s3, bytecode.ins(bytecode.stay_end()))}
end;

func push_state(st, pairs, i, n) = match i >= n
    true => st
    false => push_state(push_state_pair(st, pairs[i]), pairs, i + 1, n);

func push_state_pair(st, pair) = match pair
    StatePair.StatePair(name, value) => do
        added = add_constant(st, serialize.CStr(name));
        s1 = emit(added.st, bytecode.ins_u16(bytecode.constant(), added.index));
        compile_expr_strict(s1, value)
    end
    _ => st;

// `subject !? { success(v) => ... failure(e) => ... }`
func compile_handler(st, subject, sv, sb, fv, fb) = do
    s0 = compile_expr_strict(st, subject);
    s1 = emit(s0, bytecode.ins(bytecode.dup()));
    s2 = emit(s1, bytecode.ins(bytecode.is_success()));
    jump_fail = len(s2.code);
    s3 = emit(s2, bytecode.ins_u16(bytecode.jump_if_false(), 0));
    s4 = emit(s3, bytecode.ins(bytecode.unwrap()));
    s5 = bind_handler_var(s4, sv);
    s6 = emit(s5, bytecode.ins(bytecode.pop()));
    s7 = compile_expr_strict(s6, sb);
    jump_end = len(s7.code);
    s8 = emit(s7, bytecode.ins_u16(bytecode.jump(), 0));
    s9 = patch_u16(s8, jump_fail, len(s8.code));
    s10 = emit(s9, bytecode.ins(bytecode.unwrap()));
    s11 = bind_handler_var(s10, fv);
    s12 = emit(s11, bytecode.ins(bytecode.pop()));
    s13 = compile_expr_strict(s12, fb);
    {e: ast.EWild, st: patch_u16(s13, jump_end, len(s13.code))}
end;

// The handler variable is stored and immediately read back, which is what the
// reference emits (the body then pops it).
func bind_handler_var(st, name) = match st.in_fn
    true => bind_local_read(st, name)
    false => bind_global_read(st, name);

func bind_local_read(st, name) = do
    st2 = define_local(st, name);
    s1 = emit(st2, bytecode.ins_u8(bytecode.set_local(), st2.nlocals - 1));
    emit(s1, bytecode.ins_u8(bytecode.get_local(), st2.nlocals - 1))
end;

func bind_global_read(st, name) = do
    defined = define_global(st, name);
    s1 = emit(defined.st, bytecode.ins_u16(bytecode.set_global(), defined.index));
    emit(s1, bytecode.ins_u16(bytecode.get_global(), defined.index))
end;

func compile_index(st, left, index) = do
    s1 = compile_expr_strict(st, left);
    s2 = compile_expr_strict(s1, index);
    {e: ast.EWild, st: emit(s2, bytecode.ins(bytecode.index()))}
end;

func compile_prefix(st, op, right) = do
    s1 = compile_expr_strict(st, right);
    {e: ast.EWild, st: emit(s1, bytecode.ins(prefix_opcode(op)))}
end;

func prefix_opcode(op) = match op
    "-" => bytecode.neg()
    "!" => bytecode.not()
    "^" => bytecode.bit_not()
    _ => bytecode.dup();

func compile_success(st, value) = do
    s1 = compile_expr_strict(st, value);
    {e: ast.EWild, st: emit(s1, bytecode.ins(bytecode.wrap_success()))}
end;

func compile_failure(st, value) = do
    s1 = compile_expr_strict(st, value);
    {e: ast.EWild, st: emit(s1, bytecode.ins(bytecode.wrap_failure()))}
end;

/// A regex literal's source text is `/pattern/flags`; the constant stores the
// two parts separately.
func compile_regex(st, text) = do
    inner = string.substring(text, 1, regex_body_end(text));
    flags = string.substring_from(text, regex_body_end(text) + 1);
    compile_const(st, serialize.CRegex(inner, flags))
end;

// regex_body_end is the index of the closing slash: scanning backwards avoids
// being fooled by an escaped slash inside the pattern.
func regex_body_end(text) = regex_scan(text, 1, len(text), 1);

func regex_scan(text, i, n, last) = match i >= n
    true => last
    false => regex_scan_step(text, i, n, last);

func regex_scan_step(text, i, n, last) = match string.char_at(text, i)
    Maybe.Some("/") => regex_scan(text, i + 1, n, i)
    _ => regex_scan(text, i + 1, n, last);

// `value |> C?` pushes the value, the constraint, the value again, calls the
// constraint and wraps the result.
func compile_constraint_check(st, target) = do
    s1 = compile_expr_strict(st, target);
    {e: ast.EWild, st: emit(s1, bytecode.ins(bytecode.check_constraint()))}
end;

func compile_return(st, value) = do
    s1 = compile_expr_strict(st, value);
    {e: ast.EWild, st: emit(s1, bytecode.ins(bytecode.ret()))}
end;

func compile_tuple(st, elements) = do
    s1 = compile_args(st, elements, 0, len(elements));
    {e: ast.EWild, st: emit(s1, bytecode.ins_u16(bytecode.tuple(), len(elements)))}
end;

// Each hash pair pushes its key then its value; OpHash pops the pairs.
func compile_hash(st, pairs) = do
    s1 = compile_pairs(st, pairs, 0, len(pairs));
    {e: ast.EWild, st: emit(s1, bytecode.ins_u16(bytecode.hash_lit(), len(pairs)))}
end;

func compile_pairs(st, pairs, i, n) = match i >= n
    true => st
    false => compile_pairs(compile_pair(st, pairs[i]), pairs, i + 1, n);

func compile_pair(st, pair) = match pair
    HashPair.HashPair(key, value) => do
        s1 = compile_expr_strict(st, key);
        compile_expr_strict(s1, value)
    end
    _ => st;

// A call to a builtin compiles to OpBuiltin with the builtin's index; anything
// else is an ordinary call. The index order must match the VM's builtin list.
func compile_call_or_builtin(st, fn, args) = compile_call(st, fn, args);

// builtin_index mirrors the order of the compiler's builtin list, which is also
// the order the VM registers them in.
func builtin_index(fn) = match fn
    Expr.EIdent(name) => builtin_of(name)
    _ => Maybe.None;

func builtin_of(name) = match name
    "len" => Maybe.Some(0)
    "concat" => Maybe.Some(1)
    "to_string" => Maybe.Some(2)
    "get" => Maybe.Some(3)
    "has" => Maybe.Some(4)
    "head" => Maybe.Some(5)
    "tail" => Maybe.Some(6)
    "push" => Maybe.Some(7)
    "range" => Maybe.Some(8)
    "map" => Maybe.Some(9)
    "filter" => Maybe.Some(10)
    "reduce" => Maybe.Some(11)
    "keys" => Maybe.Some(12)
    "values" => Maybe.Some(13)
    "hash_set" => Maybe.Some(14)
    "hash_merge" => Maybe.Some(15)
    // Built-in type constraint checkers, then the common constraints: the order
    // is the compiler's builtin list, which is the order the VM registers.
    "Int" => Maybe.Some(16)
    "Float" => Maybe.Some(17)
    "String" => Maybe.Some(18)
    "Bool" => Maybe.Some(19)
    "Array" => Maybe.Some(20)
    "Hash" => Maybe.Some(21)
    "Tuple" => Maybe.Some(22)
    "Function" => Maybe.Some(23)
    "Number" => Maybe.Some(24)
    "NonZero" => Maybe.Some(25)
    "Positive" => Maybe.Some(26)
    "NonNegative" => Maybe.Some(27)
    "Natural" => Maybe.Some(28)
    "Finite" => Maybe.Some(29)
    "NonEmpty" => Maybe.Some(30)
    "Empty" => Maybe.Some(31)
    "Digits" => Maybe.Some(32)
    "Lowercase" => Maybe.Some(33)
    "Uppercase" => Maybe.Some(34)
    _ => Maybe.None;

// `&&` and `||` short-circuit, so they need jumps rather than an opcode pair.
// Chained comparisons are expanded into `&&` at parse time, so this is on the
// path for `0 <= n <= 10` too.
func compile_infix(st, op, left, right) = match op
    "&&" => compile_and(st, left, right)
    "||" => compile_or(st, left, right)
    _ => compile_binary(st, op, left, right);

func compile_and(st, left, right) = do
    s1 = compile_expr_strict(st, left);
    s2 = emit(s1, bytecode.ins(bytecode.dup()));
    jump_pos = len(s2.code);
    s3 = emit(s2, bytecode.ins_u16(bytecode.jump_if_false(), 0));
    s4 = emit(s3, bytecode.ins(bytecode.pop()));
    s5 = compile_expr_strict(s4, right);
    {e: ast.EWild, st: patch_u16(s5, jump_pos, len(s5.code))}
end;

func compile_or(st, left, right) = do
    s1 = compile_expr_strict(st, left);
    s2 = emit(s1, bytecode.ins(bytecode.dup()));
    jump_pos = len(s2.code);
    s3 = emit(s2, bytecode.ins_u16(bytecode.jump_if_true(), 0));
    s4 = emit(s3, bytecode.ins(bytecode.pop()));
    s5 = compile_expr_strict(s4, right);
    {e: ast.EWild, st: patch_u16(s5, jump_pos, len(s5.code))}
end;

// Binary arithmetic on two operands. The operand order is left then right, which
// is what the VM pops.
func compile_binary(st, op, left, right) = do
    l = compile_expr(st, left);
    r = compile_expr(l.st, right);
    {e: ast.EWild, st: emit(r.st, bytecode.ins(binary_opcode(op)))}
end;

func binary_opcode(op) = match op
    "+" => bytecode.add()
    "-" => bytecode.sub()
    "*" => bytecode.mul()
    "/" => bytecode.div()
    "%" => bytecode.mod()
    "**" => bytecode.pow()
    "==" => bytecode.equal()
    "!=" => bytecode.not_equal()
    "<" => bytecode.less()
    ">" => bytecode.greater()
    "<=" => bytecode.less_equal()
    ">=" => bytecode.greater_equal()
    "&" => bytecode.bit_and()
    "|" => bytecode.bit_or()
    "^" => bytecode.bit_xor()
    "<<" => bytecode.shl()
    ">>" => bytecode.shr()
    "~" => bytecode.regex_match()
    _ => bytecode.dup();

// ---------------------------------------------------------------------------
// Match
//
// The arm layout mirrors the reference compiler: every arm is conditional, the
// no-match handler sits *before* the final arm (after it, its instruction would
// break tail-call detection), and a trailing `_` arm emits no handler at all.
// ---------------------------------------------------------------------------

func compile_match(st, subject, cases) = do
    s1 = compile_expr_strict(st, subject);
    r = compile_arms(s1, cases, 0, len(cases), [], []);
    {e: ast.EWild, st: patch_all(r.st, r.end_jumps)}
end;

func compile_arms(st, cases, i, n, end_jumps, acc) = match i >= n
    true => {st: st, end_jumps: end_jumps}
    false => compile_arm(st, cases, i, n, end_jumps, acc);

func compile_arm(st, cases, i, n, end_jumps, acc) = do
    c = cases[i];
    last = i == n - 1;
    fail = begin_fail(st, c, last);
    rejections = compile_pattern_check(fail.st, c);
    popped = emit(rejections.st, bytecode.ins(bytecode.pop()));
    body = compile_expr(popped, case_body(c));
    jumped = end_arm(body.st, last, end_jumps);
    patch_target = match last
        true => fail.pos
        false => len(jumped.st.code);
    compile_arms(patch_jumps(jumped.st, rejections.positions, patch_target), cases, i + 1, n, jumped.end_jumps, acc)
end;

// begin_fail emits the no-match handler for a final arm that can reject.
// A Case is an ADT, so its fields are destructured rather than read.
func case_pattern(c) = match c
    Case.Case(pattern, guard, body, is_default) => pattern
    _ => ast.EWild;

func case_guard(c) = match c
    Case.Case(pattern, guard, body, is_default) => guard
    _ => ast.EWild;

func case_body(c) = match c
    Case.Case(pattern, guard, body, is_default) => body
    _ => ast.EWild;

func case_default(c) = match c
    Case.Case(pattern, guard, body, is_default) => is_default
    _ => false;

func begin_fail(st, c, last) = match last && !case_default(c)
    true => do
        skip_pos = len(st.code);
        skip = emit(st, bytecode.ins_u16(bytecode.jump(), 0));
        pos = len(skip.code);
        emitted = emit(skip, bytecode.ins(bytecode.match_fail()));
        with_fail(patch_u16(emitted, skip_pos, len(emitted.code)), pos)
    end
    false => with_fail(st, -1);

func with_fail(st, pos) = {st: st, pos: pos};

// end_arm records the jump that skips the remaining arms, except for the final
// arm: a jump there would sit between the body and OpReturn and disable TCO.
func end_arm(st, last, end_jumps) = match last
    true => {st: st, end_jumps: end_jumps}
    false => do
        pos = len(st.code);
        {st: emit(st, bytecode.ins_u16(bytecode.jump(), 0)), end_jumps: push(end_jumps, pos)}
    end;

// compile_pattern_check emits the test for one arm, leaving [subject] on the
// stack, and returns the positions of the jumps taken when it does not match.
func compile_pattern_check(st, c) = match case_default(c)
    true => check_default(st)
    false => check_pattern(st, c);

func check_default(st) = do
    s1 = emit(st, bytecode.ins(bytecode.dup()));
    {st: emit(s1, bytecode.ins(bytecode.pop())), positions: []}
end;

func check_pattern(st, c) = match case_guard(c)
    Expr.EWild => check_shape(st, case_pattern(c))
    _ => check_guard(st, c);

// A constructor pattern tests the tag and then binds or compares each payload.
func check_shape(st, p) = match p
    Expr.EConstructorPattern(type_name, name, fields) => check_ctor(st, type_name, name, fields)
    _ => check_equal(st, p);

func check_ctor(st, type_name, name, fields) = do
    s1 = emit(st, bytecode.ins(bytecode.dup()));
    added = add_constant(s1, serialize.CStr(tag_of(type_name, name)));
    s2 = emit(added.st, bytecode.ins_u16_u8(bytecode.match_adt(), added.index, len(fields)));
    s3 = emit(s2, bytecode.ins_u16(bytecode.jump_if_false(), 0));
    bound = bind_fields(s3, fields, 0, len(fields), [len(s2.code)]);
    {st: bound.st, positions: bound.positions}
end;

func tag_of(type_name, name) = match type_name == ""
    true => name
    false => concat(type_name, ".", name);

// bind_fields extracts each payload position: a name binds it, `_` drops it, a
// literal compares it.
func bind_fields(st, fields, i, n, positions) = match i >= n
    true => {st: st, positions: positions}
    false => bind_field(st, fields, i, n, positions);

func bind_field(st, fields, i, n, positions) = do
    extracted = extract_field(st, i);
    handled = apply_field(extracted, fields[i], positions);
    bind_fields(handled.st, fields, i + 1, n, handled.positions)
end;

func extract_field(st, i) = do
    s1 = emit(st, bytecode.ins(bytecode.dup()));
    added = add_constant(s1, serialize.CInt(i));
    s2 = emit(added.st, bytecode.ins_u16(bytecode.constant(), added.index));
    emit(s2, bytecode.ins(bytecode.index()))
end;

func apply_field(st, field, positions) = match field
    Expr.EWild => {st: emit(st, bytecode.ins(bytecode.pop())), positions: positions}
    Expr.EIdent(name) => {st: bind_name(st, name), positions: positions}
    _ => compare_field(st, field, positions);

func compare_field(st, field, positions) = do
    s1 = compile_expr_strict(st, field);
    s2 = emit(s1, bytecode.ins(bytecode.equal()));
    s3 = emit(s2, bytecode.ins_u16(bytecode.jump_if_false(), 0));
    {st: s3, positions: push(positions, len(s2.code))}
end;

// A pattern with no guard is an expression compared against the subject.
func check_equal(st, pattern) = do
    s1 = emit(st, bytecode.ins(bytecode.dup()));
    s2 = compile_expr_strict(s1, pattern);
    s3 = emit(s2, bytecode.ins(bytecode.equal()));
    {st: emit(s3, bytecode.ins_u16(bytecode.jump_if_false(), 0)), positions: [len(s3.code)]}
end;

// `x if cond` binds the subject to x, then tests the condition.
func check_guard(st, c) = do
    s1 = emit(st, bytecode.ins(bytecode.dup()));
    bound = bind_name(s1, ident_name(case_pattern(c)));
    s2 = compile_expr_strict(bound, case_guard(c));
    s3 = emit(s2, bytecode.ins_u16(bytecode.jump_if_false(), 0));
    {st: s3, positions: [len(s2.code)]}
end;

func ident_name(p) = match p
    Expr.EIdent(name) => name
    _ => "_";

// bind_name stores the subject (already duplicated on the stack) into a local or
// a global.
func bind_name(st, name) = match st.in_fn
    true => bind_local(st, name)
    false => bind_global(st, name);

func bind_local(st, name) = do
    st2 = define_local(st, name);
    emit(st2, bytecode.ins_u8(bytecode.set_local(), st2.nlocals - 1))
end;

func bind_global(st, name) = do
    defined = define_global(st, name);
    emit(defined.st, bytecode.ins_u16(bytecode.set_global(), defined.index))
end;

// ---------------------------------------------------------------------------
// Jump patching
// ---------------------------------------------------------------------------

func patch_all(st, positions) = patch_all_loop(st, positions, 0, len(positions));

func patch_all_loop(st, positions, i, n) = match i >= n
    true => st
    false => patch_all_loop(patch_jumps(st, [positions[i]], len(st.code)), positions, i + 1, n);

func patch_jumps(st, positions, target) = patch_jumps_loop(st, positions, 0, len(positions), target);

func patch_jumps_loop(st, positions, i, n, target) = match i >= n
    true => st
    false => patch_jumps_loop(patch_u16(st, positions[i], target), positions, i + 1, n, target);

// patch_u16 rewrites the two operand bytes of the instruction whose opcode is at
// `pos`.
func patch_u16(st, pos, value) = with_code(st, replace_range(st.code, pos + 1, [(value >> 8) & 255, value & 255]));

func replace_range(code, at, bs) = replace_loop(code, 0, len(code), at, bs, 0, len(bs), []);

func replace_loop(code, i, n, at, bs, j, m, acc) = match i >= n
    true => acc
    false => replace_loop(code, i + 1, n, at, bs, j, m, push(acc, byte_in(code, i, at, bs)));

func byte_in(code, i, at, bs) = match i >= at && i < at + len(bs)
    true => bs[i - at]
    false => code[i];

// ---------------------------------------------------------------------------
// Output
// ---------------------------------------------------------------------------

func to_bone(st) = serialize.encode_program(st.consts, st.code);
