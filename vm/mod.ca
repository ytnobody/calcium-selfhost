// vm - a bytecode interpreter written in Calcium.
//
// This is the first SH-4 slice: it interprets the structures the self-hosted
// compiler already produces (its constant pool and instruction stream), so it
// exercises instruction semantics without also needing a .bone reader.
//
// Values are Calcium values. Only what Calcium cannot express is wrapped:
// closures, builtins, ADT values, and host functions.
//
// The interpreter runs on the reference VM, so a program that wants to print has
// to reach the host's facilities. Module loading goes through a small registry of
// Calcium-implemented modules instead of the host's loader.

namespace vm;

use core.string;
use core.types;
use core.io!;
use core.math;
use core.array;
use bytecode;
use serialize;

// ---------------------------------------------------------------------------
// Runtime values
// ---------------------------------------------------------------------------

type Value =
    Closure(record, free) |
    BuiltinFn(index) |
    AdtVal(type_name, tag, items) |
    HostFn(name);

type Frame = Frame(cl, ip, base);

// State: operand stack, frames, globals, constant pool.
func new_state(constants) = {stack: [], top: 0, frames: [], last: 0, globals: [], constants: constants};

func set_state(st, stack, top, frames, last, globals) =
    {stack: stack, top: top, frames: frames, last: last, globals: globals, constants: st.constants};

// ---------------------------------------------------------------------------
// Operand stack
// ---------------------------------------------------------------------------

func push_value(st, v) = set_state(st,
    put_at(st.stack, st.top, v), st.top + 1, st.frames, st.last, st.globals);

// put_at writes at index i, padding with zeros when i is beyond the end. Writing
// *past* the end matters: a global slot is allocated by index, and pushing would
// put the value at the wrong index whenever an earlier slot is still unwritten.
func put_at(arr, i, v) = match i < len(arr)
    true => replace_at(arr, 0, i, v, [])
    false => pad_and_push(arr, i, v);

func pad_and_push(arr, i, v) = match len(arr) >= i
    true => push(arr, v)
    false => pad_and_push(push(arr, 0), i, v);

func replace_at(arr, j, i, v, acc) = match j >= len(arr)
    true => acc
    false => replace_at(arr, j + 1, i, v, push(acc, choose(arr[j], v, j == i)));

func choose(a, b, take_b) = match take_b
    true => b
    false => a;

func pop_value(st) = {v: st.stack[st.top - 1], st: set_state(st, st.stack, st.top - 1, st.frames, st.last, st.globals)};

func peek(st) = st.stack[st.top - 1];

// ---------------------------------------------------------------------------
// Frames
// ---------------------------------------------------------------------------

func current(st) = st.frames[len(st.frames) - 1];

func push_frame(st, cl, base) = set_state(st, st.stack, st.top,
    push(st.frames, make_frame(cl, 0, base)), st.last, st.globals);

func pop_frame(st) = set_state(st, st.stack, st.top,
    take(st.frames, 0, len(st.frames) - 1, []), st.last, st.globals);

func take(arr, i, n, acc) = match i >= n
    true => acc
    false => take(arr, i + 1, n, push(acc, arr[i]));

func set_frame(st, f) = set_state(st, st.stack, st.top,
    replace_at(st.frames, 0, len(st.frames) - 1, f, []), st.last, st.globals);

// A Frame is an ADT, so its fields are destructured.
func frame_cl(f) = match f
    Frame.Frame(cl, ip, base) => cl
    _ => Closure(serialize.FunctionRecord("", "entry", [], 0, false, []), []);

func frame_ip(f) = match f
    Frame.Frame(cl, ip, base) => ip
    _ => 0;

func frame_base(f) = match f
    Frame.Frame(cl, ip, base) => base
    _ => 0;

func make_frame(cl, ip, base) = Frame(cl, ip, base);

func set_ip(st, ip) = do
    f = current(st);
    set_frame(st, make_frame(frame_cl(f), ip, frame_base(f)))
end;

// ---------------------------------------------------------------------------
// Constants
// ---------------------------------------------------------------------------

func constant_value(c) = match c
    Constant.CBool(v) => v
    Constant.CInt(v) => v
    Constant.CFloat(v) => v
    Constant.CStr(v) => v
    Constant.CAdt(name, tag, items) => AdtVal(name, tag, map_constants(items, 0, len(items), []))
    Constant.CFunc(record) => Closure(record, [])
    Constant.CRegex(pattern, flags) => pattern
    _ => 0;

func map_constants(items, i, n, acc) = match i >= n
    true => acc
    false => map_constants(items, i + 1, n, push(acc, constant_value(items[i])));

// ---------------------------------------------------------------------------
// Instruction encoding
// ---------------------------------------------------------------------------

func read_u16(code, ip) = code[ip + 1] * 256 + code[ip + 2];

func read_u8(code, ip) = code[ip + 1];

// width is the size of the instruction at `ip`, which the reference format does
// not encode; it comes from the opcode's operand layout.
func width(code, ip) = operand_bytes(code[ip]) + 1;

func operand_bytes(op) = match op
    bytecode.closure() => 3
    bytecode.construct_adt() => 3
    bytecode.match_adt() => 3
    bytecode.constant() => 2
    bytecode.get_global() => 2
    bytecode.set_global() => 2
    bytecode.get_member() => 2
    bytecode.load_module() => 2
    bytecode.array() => 2
    bytecode.array_concat() => 2
    bytecode.tuple() => 2
    bytecode.hash_lit() => 2
    bytecode.jump() => 2
    bytecode.jump_if_false() => 2
    bytecode.jump_if_true() => 2
    bytecode.unwrap_or_jump() => 2
    bytecode.get_local() => 1
    bytecode.set_local() => 1
    bytecode.get_free() => 1
    bytecode.call() => 1
    bytecode.tail_call() => 1
    bytecode.call_effect() => 1
    bytecode.builtin() => 1
    _ => 0;

// ---------------------------------------------------------------------------
// Modules
//
// The host's module loader is not reachable from Calcium, so the interpreter
// provides the few members it needs itself.
// ---------------------------------------------------------------------------

// Modules are provided by forwarding to the host's own stdlib: the interpreter
// runs on the reference VM, so `string.trim` etc. are reachable even though the
// host's *module loader* is not. Any other module is unsupported.
func module_member(path, name) = match path
    "core.io" => io_member(name)
    "core.string" => HostFn(concat("core.string:", name))
    "core.array" => HostFn(concat("core.array:", name))
    "core.math" => HostFn(concat("core.math:", name))
    "core.types" => HostFn(concat("core.types:", name))
    _ => HostFn("unsupported-module:");

func io_member(name) = match name
    "say" => HostFn("say")
    "println" => HostFn("println")
    "print" => HostFn("print")
    _ => HostFn("unsupported-member:");

// ---------------------------------------------------------------------------
// Builtins
// ---------------------------------------------------------------------------

func builtin_names() = [
    "len", "concat", "to_string", "get", "has", "head", "tail", "push",
    "range", "map", "filter", "reduce", "keys", "values", "hash_set",
    "hash_merge", "Int", "Float", "String", "Bool", "Array", "Hash", "Tuple",
    "Function", "Number", "NonZero", "Positive", "NonNegative", "Natural",
    "Finite", "NonEmpty", "Empty", "Digits", "Lowercase", "Uppercase"
];

func builtin_name(index) = builtin_names()[index];

// ---------------------------------------------------------------------------
// Function record accessors
//
// A FunctionRecord is a serialize ADT, so its fields are destructured.
// ---------------------------------------------------------------------------

func fn_name(r) = match r
    FunctionRecord.FunctionRecord(name, module_id, params, nlocals, is_effect, body) => name
    _ => "";

func fn_body(r) = match r
    FunctionRecord.FunctionRecord(name, module_id, params, nlocals, is_effect, body) => body
    _ => [];

func fn_num_locals(r) = match r
    FunctionRecord.FunctionRecord(name, module_id, params, nlocals, is_effect, body) => nlocals
    _ => 0;

func cl_body(cl) = match cl
    Closure(record, free) => fn_body(record)
    _ => [];

func cl_locals(cl) = match cl
    Closure(record, free) => fn_num_locals(record)
    _ => 0;

func cl_free(cl) = match cl
    Closure(record, free) => free
    _ => [];

// ---------------------------------------------------------------------------
// Interpreter
// ---------------------------------------------------------------------------

func run(constants, instructions) = do
    main = Closure(serialize.FunctionRecord("<main>", "entry", [], 0, false, instructions), []);
    st = push_frame(new_state(constants), main, 0);
    exec(st)
end;

// exec is tail-recursive: one step per instruction, so a long program does not
// grow the stack.
func exec(st) = match len(st.frames) == 0
    true => st.last
    false => exec(step(st));

func step(st) = do
    f = current(st);
    code = cl_body(frame_cl(f));
    ip = frame_ip(f);
    match ip >= len(code)
        true => finish(st)
        false => finished_of(dispatch(st, code[ip], ip))
end;

func finished_of(next) = match next.ok
    true => next.st
    false => next.st;

// finish pops a frame that has run out of instructions, which is how the main
// program's body ends: it has no OpReturn of its own.
func finish(st) = do
    base = frame_base(current(st));
    st2 = pop_frame(st);
    value = match st.top > base
        true => st.stack[st.top - 1]
        false => 0;
    set_state(st2, st2.stack, base, st2.frames, value, st2.globals)
end;

// advance moves the instruction pointer past the instruction at `ip`.
func advance(st, ip) = set_ip(st, ip + width(cl_body(frame_cl(current(st))), ip));

// fail records a runtime error and unwinds every frame, naming the function that
// was executing so a no-match is diagnosable.
func fail(st, message) = {ok: false, st: set_state(st, st.stack, st.top, [], failed_message(st, message), st.globals)};

func failed_message(st, message) = match len(st.frames) == 0
    true => message
    false => concat(message, " (in ", fn_name(frame_cl(current(st))),
        " at ", to_string(frame_ip(current(st))), ")");
func done(st) = {ok: true, st: st};

func dispatch(st, op, ip) = match op
    bytecode.constant() => op_constant(st, ip)
    bytecode.pop() => op_pop(st, ip)
    bytecode.dup() => op_dup(st, ip)
    bytecode.get_local() => op_get_local(st, ip)
    bytecode.set_local() => op_set_local(st, ip)
    bytecode.get_global() => op_get_global(st, ip)
    bytecode.set_global() => op_set_global(st, ip)
    bytecode.add() => op_numeric(st, ip, "add")
    bytecode.sub() => op_numeric(st, ip, "sub")
    bytecode.mul() => op_numeric(st, ip, "mul")
    bytecode.div() => op_numeric(st, ip, "div")
    bytecode.mod() => op_numeric(st, ip, "mod")
    bytecode.pow() => op_numeric(st, ip, "pow")
    bytecode.neg() => op_unary(st, ip, "neg")
    bytecode.not() => op_unary(st, ip, "not")
    bytecode.bit_not() => op_unary(st, ip, "bit_not")
    bytecode.bit_and() => op_numeric(st, ip, "bit_and")
    bytecode.bit_or() => op_numeric(st, ip, "bit_or")
    bytecode.bit_xor() => op_numeric(st, ip, "bit_xor")
    bytecode.shl() => op_numeric(st, ip, "shl")
    bytecode.shr() => op_numeric(st, ip, "shr")
    bytecode.equal() => op_compare(st, ip, "equal")
    bytecode.not_equal() => op_compare(st, ip, "not_equal")
    bytecode.less() => op_compare(st, ip, "less")
    bytecode.greater() => op_compare(st, ip, "greater")
    bytecode.less_equal() => op_compare(st, ip, "less_equal")
    bytecode.greater_equal() => op_compare(st, ip, "greater_equal")
    bytecode.jump() => set_ip_after(st, read_u16(cl_body(frame_cl(current(st))), ip))
    bytecode.jump_if_false() => op_jump_if(st, ip, false)
    bytecode.jump_if_true() => op_jump_if(st, ip, true)
    bytecode.call() => op_call(st, ip, read_u8(cl_body(frame_cl(current(st))), ip))
    bytecode.call_effect() => op_call(st, ip, read_u8(cl_body(frame_cl(current(st))), ip))
    bytecode.tail_call() => op_tail_call(st, ip, read_u8(cl_body(frame_cl(current(st))), ip))
    bytecode.ret() => op_ret(st, ip)
    bytecode.closure() => op_closure(st, ip)
    bytecode.get_free() => op_get_free(st, ip)
    bytecode.array() => op_array(st, ip, read_u16(cl_body(frame_cl(current(st))), ip), false)
    bytecode.array_concat() => op_array(st, ip, read_u16(cl_body(frame_cl(current(st))), ip), true)
    bytecode.tuple() => op_tuple(st, ip, read_u16(cl_body(frame_cl(current(st))), ip))
    bytecode.hash_lit() => op_hash(st, ip, read_u16(cl_body(frame_cl(current(st))), ip))
    bytecode.index() => op_index(st, ip)
    bytecode.get_member() => op_get_member(st, ip)
    bytecode.load_module() => op_load_module(st, ip)
    bytecode.builtin() => op_builtin(st, ip, read_u8(cl_body(frame_cl(current(st))), ip))
    bytecode.true_() => op_push(st, ip, true)
    bytecode.false_() => op_push(st, ip, false)
    bytecode.none() => op_push(st, ip, Maybe.None)
    bytecode.construct_adt() => op_construct_adt(st, ip)
    bytecode.match_adt() => op_match_adt(st, ip)
    bytecode.wrap_success() => op_wrap(st, ip, true)
    bytecode.wrap_failure() => op_wrap(st, ip, false)
    bytecode.is_success() => op_is_wrapped(st, ip, true)
    bytecode.is_failure() => op_is_wrapped(st, ip, false)
    bytecode.unwrap() => op_unwrap(st, ip)
    bytecode.match_fail() => op_match_fail(st, ip)
    _ => fail(st, concat("unsupported opcode ", to_string(op)));

func set_ip_after(st, ip) = done(set_ip(st, ip));

// A no-match reports the subject, which is what makes this diagnosable.
func op_match_fail(st, ip) = do
    r = pop_value(st);
    fail(r.st, concat("no match arm matched ", vm_to_string(r.v)))
end;

// ---------------------------------------------------------------------------
// Simple opcodes
// ---------------------------------------------------------------------------

func op_constant(st, ip) = done(advance(push_value(st, constant_value(st.constants[read_u16(cl_body(frame_cl(current(st))), ip)])), ip));

func op_pop(st, ip) = done(advance(pop_value(st).st, ip));

func op_dup(st, ip) = done(advance(push_value(st, peek(st)), ip));

func op_push(st, ip, v) = done(advance(push_value(st, v), ip));

func op_get_local(st, ip) = do
    idx = read_u8(cl_body(frame_cl(current(st))), ip);
    done(advance(push_value(st, stack_at(st.stack, frame_base(current(st)) + idx)), ip))
end;

func ensure_size(arr, n) = match len(arr) >= n
    true => arr
    false => ensure_size(push(arr, 0), n);

// stack_at reads a slot, or 0 when it has not been written yet. Local slots are
// reserved by the call but only filled by the code that assigns them.
func stack_at(arr, i) = match i >= 0 && i < len(arr)
    true => arr[i]
    false => 0;

func op_set_local(st, ip) = do
    idx = read_u8(cl_body(frame_cl(current(st))), ip);
    r = pop_value(st);
    target = frame_base(current(st)) + idx;
    done(advance(set_state(r.st, put_at(r.st.stack, target, r.v), r.st.top, r.st.frames, r.st.last, r.st.globals), ip))
end;

// A global slot can be read before it is written: the compiler predeclares every
// top-level name so functions can refer to each other, which allocates indices
// before the assignments that fill them.
func op_get_global(st, ip) = do
    idx = read_u16(cl_body(frame_cl(current(st))), ip);
    done(advance(push_value(st, stack_at(st.globals, idx)), ip))
end;

func op_set_global(st, ip) = do
    idx = read_u16(cl_body(frame_cl(current(st))), ip);
    r = pop_value(st);
    done(advance(set_globals(r.st, put_at(r.st.globals, idx, r.v)), ip))
end;

func set_globals(st, globals) = set_state(st, st.stack, st.top, st.frames, st.last, globals);

func op_get_free(st, ip) = do
    idx = read_u8(cl_body(frame_cl(current(st))), ip);
    done(advance(push_value(st, cl_free(frame_cl(current(st)))[idx]), ip))
end;

func op_closure(st, ip) = do
    code = cl_body(frame_cl(current(st)));
    idx = read_u16(code, ip);
    count = code[ip + 3];
    frees = pop_n(st, count);
    cl = Closure(constant_record(st.constants[idx]), frees.items);
    done(advance(push_value(frees.st, cl), ip))
end;

func constant_record(c) = match c
    Constant.CFunc(record) => record
    _ => serialize.FunctionRecord("", "entry", [], 0, false, []);

// pop_n removes n values, preserving their order.
func pop_n(st, n) = pop_n_loop(st, n, []);

func pop_n_loop(st, n, acc) = match n <= 0
    true => {st: st, items: acc}
    false => do
        r = pop_value(st);
        pop_n_loop(r.st, n - 1, push_front(acc, r.v))
    end;

func push_front(arr, v) = push_front_loop(arr, v, 0, len(arr), [v]);

func push_front_loop(arr, v, i, n, acc) = match i >= n
    true => acc
    false => push_front_loop(arr, v, i + 1, n, push(acc, arr[i]));

// ---------------------------------------------------------------------------
// Arithmetic and comparison
// ---------------------------------------------------------------------------

func op_numeric(st, ip, kind) = do
    r = pop_value(st);
    l = pop_value(r.st);
    done(advance(push_value(l.st, numeric(kind, l.v, r.v)), ip))
end;

func numeric(kind, a, b) = match kind
    "add" => a + b
    "sub" => a - b
    "mul" => a * b
    "div" => a / b
    "mod" => a % b
    "pow" => a ** b
    "bit_and" => a & b
    "bit_or" => a | b
    "bit_xor" => a ^ b
    "shl" => a << b
    "shr" => a >> b
    _ => 0;

func op_unary(st, ip, kind) = do
    r = pop_value(st);
    done(advance(push_value(r.st, unary(kind, r.v)), ip))
end;

func unary(kind, v) = match kind
    "neg" => 0 - v
    "not" => !v
    "bit_not" => ^v
    _ => v;

func op_compare(st, ip, kind) = do
    r = pop_value(st);
    l = pop_value(r.st);
    done(advance(push_value(l.st, compare(kind, l.v, r.v)), ip))
end;

func compare(kind, a, b) = match kind
    "equal" => a == b
    "not_equal" => a != b
    "less" => a < b
    "greater" => a > b
    "less_equal" => a <= b
    "greater_equal" => a >= b
    _ => false;

// ---------------------------------------------------------------------------
// Jumps
// ---------------------------------------------------------------------------

func op_jump_if(st, ip, want_true) = do
    r = pop_value(st);
    target = read_u16(cl_body(frame_cl(current(st))), ip);
    jump = match r.v
        true => want_true
        false => !want_true;
    match jump
        true => done(set_ip(r.st, target))
        false => done(advance(r.st, ip))
end;

// ---------------------------------------------------------------------------
// Calls
// ---------------------------------------------------------------------------

// The caller's program counter is advanced *before* the callee runs: a return
// resumes the caller at its next instruction, so leaving the counter on the call
// would execute it again.
//
// run_callee is effectful (a host call prints), so its result can arrive wrapped
// in success/failure and has to be unwrapped.
func op_call(st, ip, nargs) = do
    st1 = advance(st, ip);
    base = st1.top - nargs;
    callee = st1.stack[base - 1];
    apply(unwrap_callee(run_callee(st1, callee, base, nargs, false), st1))
end;

// A tail call to a closure replaces the frame, so the current program counter is
// discarded and needs no advancing. A tail call to a builtin or host function has
// no frame to replace, so it has to return from the current frame - otherwise the
// frame would keep executing with the callee's result on top of its stack, and any
// caller looping until the frame count drops (map, filter, reduce) would spin.
func op_tail_call(st, ip, nargs) = do
    base = st.top - nargs;
    callee = st.stack[base - 1];
    r = unwrap_callee(run_callee(st, callee, base, nargs, true), st);
    match r.finished
        true => return_value(r.st, r.v)
        false => done(r.st)
end;

// run_callee is an effect function, so its result is normally wrapped in success.
// In practice the wrapper is not always present (a match-bodied effect function
// returns its value directly), and `!?` would then take the failure branch and
// bury the record. Accepting a plain record first makes this independent of which
// shape arrives.
func unwrap_callee(wrapped, st) = match types.is_hash(wrapped)
    true => wrapped
    false => unwrap_wrapped_callee(wrapped, st);

func unwrap_wrapped_callee(wrapped, st) = wrapped !? {
    success(v) => v
    failure(e) => failed_callee(st, e)
};

func failed_callee(st, reason) = {finished: true, st: st, v: failure(reason)};

func apply(r) = match r.finished
    true => done(push_value(r.st, r.v))
    false => done(r.st);

// run_callee either finishes a builtin (whose result is `v`) or pushes a frame
// for a closure. Tail calls replace the current frame instead of growing the
// frame stack.
func! run_callee(st, callee, base, nargs, tail) = match callee
    Closure(record, frees) => call_closure(st, callee, base, nargs, tail)
    BuiltinFn(index) => call_builtin_value(st, index, base, nargs)
    HostFn(name) => call_host(st, name, base, nargs)
    _ => {finished: true, st: st, v: 0};

func call_closure(st, callee, base, nargs, tail) = do
    locals_count = cl_locals(callee);
    top = base + locals_count;
    // Reserve the local slots: they are written by the callee, but reads (and
    // pops) can happen before that, so the array has to reach `top`.
    st2 = set_state(st, ensure_size(st.stack, top), top, st.frames, st.last, st.globals);
    match tail
        true => {finished: false, st: tail_frame(st, callee, base, nargs)}
        false => {finished: false, st: push_frame(st2, callee, base)}
end;

// A tail call replaces the current frame. The frame keeps its own base - that is
// where the *original* caller expects the result - so the callee's arguments are
// moved down to it, exactly as the reference VM does. Keeping the new argument
// position as the base instead leaves the caller's slots untrimmed, which is why
// `n |> inc |> (r => ...)` computed the right value and then printed nothing.
func tail_frame(st, callee, args_base, nargs) = do
    fbase = frame_base(current(st));
    moved = copy_down(st.stack, args_base, fbase, nargs);
    top = fbase + cl_locals(callee);
    set_state(st, ensure_size(moved, top), top,
        replace_at(st.frames, 0, len(st.frames) - 1, make_frame(callee, 0, fbase), []),
        st.last, st.globals)
end;

// copy_down moves `n` slots from `from` to `to` (to < from).
func copy_down(arr, from, to, n) = copy_down_loop(arr, from, to, 0, n, []);

func copy_down_loop(arr, from, to, i, n, acc) = match i >= len(arr)
    true => acc
    false => copy_down_loop(arr, from, to, i + 1, n,
        push(acc, move_value(arr, from, to, i, n)));

func move_value(arr, from, to, i, n) = match i >= to && i < to + n
    true => arr[from + (i - to)]
    false => arr[i];

// A return removes the frame, drops the callee and argument slots, and leaves the
// return value in their place for the caller.
func op_ret(st, ip) = do
    r = pop_value(st);
    return_value(r.st, r.v)
end;

// return_value pops the current frame and leaves `v` where the callee and its
// arguments were.
func return_value(st, v) = do
    base = frame_base(current(st));
    st2 = pop_frame(st);
    st3 = set_state(st2, st2.stack, base - 1, st2.frames, v, st2.globals);
    {ok: true, st: push_value(st3, v)}
end;

// ---------------------------------------------------------------------------
// Containers
// ---------------------------------------------------------------------------

func op_array(st, ip, n, concat) = do
    r = pop_n(st, n);
    done(advance(push_value(r.st, r.items), ip))
end;

// A tuple is represented as an array: Calcium has no way to build a tuple value
// dynamically, and the difference is only visible in to_string.
func op_tuple(st, ip, n) = op_array(st, ip, n, false);

func op_hash(st, ip, n) = do
    r = pop_n(st, n * 2);
    done(advance(push_value(r.st, build_hash(r.items, 0, len(r.items), {})), ip))
end;

func build_hash(items, i, n, acc) = match i + 1 >= n
    true => acc
    false => build_hash(items, i + 2, n, hash_set(acc, items[i], items[i + 1]));

func op_index(st, ip) = do
    idx = pop_value(st);
    obj = pop_value(idx.st);
    done(advance(push_value(obj.st, index_into(obj.v, idx.v)), ip))
end;

// Indexing a hash yields the value itself, not a Maybe: the compiler emits
// OpIndex for `h[k]`, and a missing key is an error in the reference.
// An ADT index selects a constructor payload, which is how OpIndex binds a
// field in a constructor pattern.
func index_into(obj, idx) = match obj
    AdtVal(type_name, tag, items) => adt_item(items, idx)
    _ => index_container(obj, idx);

func adt_item(items, idx) = match idx >= 0 && idx < len(items)
    true => items[idx]
    false => 0;

func index_container(obj, idx) = match types.is_array(obj)
    true => obj[idx]
    false => match types.is_hash(obj)
        true => get(obj, idx, 0)
        false => obj;

func op_get_member(st, ip) = do
    name = member_name(st, read_u16(cl_body(frame_cl(current(st))), ip));
    obj = pop_value(st);
    done(advance(push_value(obj.st, member_of(obj.v, name)), ip))
end;

func member_name(st, idx) = match st.constants[idx]
    Constant.CStr(v) => v
    _ => "";

func member_of(obj, name) = match types.is_hash(obj)
    true => module_or_hash(obj, name)
    false => obj;

// A module is represented as a hash with a `__module` marker.
// Member access yields the value itself, not a Maybe: `h.name` is a field read.
// A bare identifier in a match arm is an expression to compare, not a binding, so
// the module path is read again rather than captured.
func module_or_hash(obj, name) = match get(obj, "__module", "")
    "" => get(obj, name, 0)
    _ => module_member(get(obj, "__module", ""), name);

func op_load_module(st, ip) = do
    path = member_name(st, read_u16(cl_body(frame_cl(current(st))), ip));
    done(advance(push_value(st, {"__module": path}), ip))
end;

func op_builtin(st, ip, index) = done(advance(push_value(st, BuiltinFn(index)), ip));

// ---------------------------------------------------------------------------
// ADTs and Result values
// ---------------------------------------------------------------------------

func op_construct_adt(st, ip) = do
    code = cl_body(frame_cl(current(st)));
    tag = member_name(st, read_u16(code, ip));
    arity = code[ip + 3];
    r = pop_n(st, arity);
    done(advance(push_value(r.st, make_adt(tag, r.items)), ip))
end;

func make_adt(tag, items) = do
    parts = string.split(tag, ".");
    type_name = match len(parts) > 1
        true => parts[0]
        false => tag;
    variant = match len(parts) > 1
        true => parts[1]
        false => tag;
    AdtVal(type_name, variant, items)
end;

func op_match_adt(st, ip) = do
    expected = member_name(st, read_u16(cl_body(frame_cl(current(st))), ip));
    r = pop_value(st);
    done(advance(push_value(r.st, adt_matches(r.v, expected)), ip))
end;

func adt_matches(v, expected) = match v
    AdtVal(type_name, tag, items) => tag == expected || concat(type_name, ".", tag) == expected
    _ => false;

func op_wrap(st, ip, ok) = do
    r = pop_value(st);
    done(advance(push_value(r.st, wrap_value(r.v, ok)), ip))
end;

// Result values are represented with the interpreter's own ADT rather than
// Calcium's `success`/`failure`: those are keywords, so their payload cannot be
// destructured with a constructor pattern.
func wrap_value(v, ok) = match ok
    true => AdtVal("Result", "success", [v])
    false => AdtVal("Result", "failure", [v]);

func op_is_wrapped(st, ip, want_success) = do
    r = pop_value(st);
    done(advance(push_value(r.st, is_wrapped(r.v, want_success)), ip))
end;

func is_wrapped(v, want_success) = match v
    AdtVal(type_name, tag, items) => result_tag(tag, want_success)
    _ => false;

func result_tag(tag, want_success) = match want_success
    true => tag == "success"
    false => tag == "failure";

func op_unwrap(st, ip) = do
    r = pop_value(st);
    done(advance(push_value(r.st, unwrapped(r.v)), ip))
end;

func unwrapped(v) = match v
    AdtVal(type_name, tag, items) => items[0]
    _ => v;

// ---------------------------------------------------------------------------
// Builtin calls
// ---------------------------------------------------------------------------

// Higher-order builtins call back into the interpreter, so they are handled
// before the plain `apply_builtin` table.
//
// The argument order is the one the compiler emits: `arr |> map(f)` pushes the
// array and then the function, and `reduce` pushes (array, init, function) - which
// is *not* what the reference VM expects, so `reduce` fails there too. That
// failure is reproduced rather than fixed, because behaviour is the contract.
func call_builtin_value(st, index, base, nargs) = do
    r = pop_n(st, nargs);
    remaining = set_state(r.st, r.st.stack, base - 1, r.st.frames, r.st.last, r.st.globals);
    name = builtin_name(index);
    match name
        "map" => higher_order_map(remaining, r.items)
        "filter" => higher_order_filter(remaining, r.items)
        "reduce" => higher_order_reduce(remaining, r.items)
        _ => {finished: true, st: remaining, v: apply_builtin(name, r.items)}
end;

// call_sync runs a closure to completion and returns its value, leaving the
// caller's stack pointer where it was.
func call_sync(st, fn, arg_values) = do
    top0 = st.top;
    base = st.top;
    // The callee sits at `base` and the arguments follow it, so the frame's locals
    // start one slot later. Getting this wrong makes local 0 the callee itself.
    pushed = push_value(st, fn);
    with_args = push_values(pushed, arg_values, 0, len(arg_values));
    started = start_frame(with_args, fn, base + 1);
    ran = run_until(started, len(st.frames));
    {st: set_state(ran, ran.stack, top0, ran.frames, ran.last, ran.globals),
     v: stack_at(ran.stack, base)}
end;

func push_values(st, values, i, n) = match i >= n
    true => st
    false => push_values(push_value(st, values[i]), values, i + 1, n);

func start_frame(st, fn, base) = do
    locals_count = cl_locals(fn);
    top = base + locals_count;
    set_state(st, ensure_size(st.stack, top), top, push(st.frames, make_frame(fn, 0, base)), st.last, st.globals)
end;

func run_until(st, target) = match len(st.frames) <= target
    true => st
    false => run_until(step(st), target);

// is_callable covers the interpreter's own function wrappers, which Calcium's
// type predicates do not know about.
func is_callable(v) = match v
    Closure(record, frees) => true
    BuiltinFn(index) => true
    HostFn(name) => true
    _ => false;

func higher_order_map(st, items) = match len(items) == 2 && types.is_array(items[0])
    true => do
        r = map_loop(st, items[1], items[0], 0, len(items[0]), []);
        {finished: true, st: r.st, v: r.items}
    end
    false => {finished: true, st: st, v: failure("map: expected 2 arguments (array, fn)")};

func map_loop(st, fn, arr, i, n, acc) = match i >= n
    true => {st: st, items: acc}
    false => do
        r = call_sync(st, fn, [arr[i]]);
        map_loop(r.st, fn, arr, i + 1, n, push(acc, r.v))
    end;

func higher_order_filter(st, items) = match len(items) == 2 && types.is_array(items[0])
    true => do
        r = filter_loop(st, items[1], items[0], 0, len(items[0]), []);
        {finished: true, st: r.st, v: r.items}
    end
    false => {finished: true, st: st, v: failure("filter: expected 2 arguments (array, fn)")};

func filter_loop(st, fn, arr, i, n, acc) = match i >= n
    true => {st: st, items: acc}
    false => do
        r = call_sync(st, fn, [arr[i]]);
        filter_loop(r.st, fn, arr, i + 1, n, keep_if(r.v, acc, arr[i]))
    end;

func keep_if(v, acc, element) = match v
    true => push(acc, element)
    _ => acc;

// reduce reads its function from position 2, as the reference VM does. The
// compiler pushes the initial value there, so a piped reduce reports the same
// failure the reference reports.
func higher_order_reduce(st, items) = match len(items) == 3 && types.is_array(items[0]) && is_callable(items[1])
    true => do
        r = reduce_loop(st, items[1], items[0], items[2], 0, len(items[0]));
        {finished: true, st: r.st, v: r.acc}
    end
    false => {finished: true, st: st, v: reduce_failure(items)};

func reduce_failure(items) = match len(items) == 3 && types.is_array(items[0])
    true => failure("reduce: second argument must be function")
    false => failure("reduce: expected 3 arguments (array, fn, init)");

func reduce_loop(st, fn, arr, acc, i, n) = match i >= n
    true => {st: st, acc: acc}
    false => do
        r = call_sync(st, fn, [acc, arr[i]]);
        reduce_loop(r.st, fn, arr, r.v, i + 1, n)
    end;

func apply_builtin(name, args) = match name
    "len" => len_of(args[0])
    "get" => builtin_get(args)
    "has" => builtin_has(args)
    "head" => builtin_head(args)
    "tail" => builtin_tail(args)
    "push" => builtin_push(args)
    "range" => builtin_range(args)
    "keys" => keys(args[0])
    "values" => values(args[0])
    "hash_set" => hash_set(args[0], args[1], args[2])
    "hash_merge" => hash_merge(args[0], args[1])
    "concat" => concat_values(args)
    "to_string" => to_string(args[0])
    "Int" => types.is_int(args[0])
    "Float" => types.is_float(args[0])
    "String" => types.is_string(args[0])
    "Bool" => types.is_bool(args[0])
    "Array" => types.is_array(args[0])
    "Hash" => types.is_hash(args[0])
    "Tuple" => types.is_array(args[0])
    "Function" => types.is_function(args[0])
    "Number" => types.is_number(args[0])
    "NonZero" => args[0] != 0
    "Positive" => args[0] > 0
    "NonNegative" => args[0] >= 0
    "Natural" => args[0] >= 0
    "Finite" => true
    "NonEmpty" => len_of(args[0]) > 0
    "Empty" => len_of(args[0]) == 0
    _ => failure(concat("unsupported builtin: ", name));

// get(collection, key) yields a Maybe; the three-argument form yields the value
// or a default, which is what `h[k]` compiles to in this interpreter.
func builtin_get(args) = match len(args) == 3
    true => get(args[0], args[1], args[2])
    false => get(args[0], args[1]);

func builtin_has(args) = has(args[0], args[1]);

func builtin_head(args) = head(args[0]);

func builtin_tail(args) = tail(args[0]);

func builtin_push(args) = push(args[0], args[1]);

// range(end) / range(start, end) / range(start, end, step), as the reference
// builds them.
func builtin_range(args) = match len(args)
    1 => range(0, args[0])
    2 => range(args[0], args[1])
    _ => range(args[0], args[1], args[2]);

func len_of(v) = match types.is_array(v)
    true => len(v)
    false => match types.is_string(v)
        true => len(v)
        false => match types.is_hash(v)
            true => len(keys(v))
            false => 0;

func concat_values(args) = match len(args) == 0
    true => ""
    false => concat_values_loop(args, 0, len(args), "");

func concat_values_loop(args, i, n, acc) = match i >= n
    true => acc
    false => concat_values_loop(args, i + 1, n, concat(acc, args[i]));

// ---------------------------------------------------------------------------
// Host calls
//
// Printing has no Calcium implementation, so `core.io` members are forwarded to
// the reference VM's own facilities. Anything else is unsupported.
// ---------------------------------------------------------------------------

// host_apply returns a `{ok, v}` record rather than a bare value or a Result.
// Calcium's `success`/`failure` cannot be destructured, and an effect function
// with a match body is not wrapped, so neither `!?` nor a plain read is reliable
// across both shapes; result_record accepts either.
func! call_host(st, name, base, nargs) = do
    r = pop_n(st, nargs);
    result = result_record(host_apply(name, r.items)).v;
    remaining = set_state(r.st, r.st.stack, base - 1, r.st.frames, r.st.last, r.st.globals);
    {finished: true, st: remaining, v: result}
end;

// call_n applies a function value to an argument array. The spread form
// (`f(args...)`) cannot be used here: calling a *module member* with a spread
// fails in the reference implementation, so the arity is dispatched explicitly.
func call_n(f, args) = match len(args)
    0 => f()
    1 => f(args[0])
    2 => f(args[0], args[1])
    3 => f(args[0], args[1], args[2])
    4 => f(args[0], args[1], args[2], args[3])
    _ => failure("too many arguments");

func result_record(v) = match types.is_hash(v)
    true => v
    false => {ok: true, v: v};

func host_ok(v) = {ok: true, v: v};
func host_err(m) = {ok: false, v: failure(m)};

func! host_apply(name, args) = match name
    "say" => do
        host_say(args);
        host_ok(Maybe.None)
    end
    "println" => do
        host_say(args);
        host_ok(Maybe.None)
    end
    "print" => do
        host_say(args);
        host_ok(Maybe.None)
    end
    "core.string:split" => host_ok(call_n(string.split, args))
    "core.string:join" => host_ok(call_n(string.join, args))
    "core.string:trim" => host_ok(call_n(string.trim, args))
    "core.string:upper" => host_ok(call_n(string.upper, args))
    "core.string:to_upper" => host_ok(call_n(string.to_upper, args))
    "core.string:lower" => host_ok(call_n(string.lower, args))
    "core.string:to_lower" => host_ok(call_n(string.to_lower, args))
    "core.string:replace" => host_ok(call_n(string.replace, args))
    "core.string:substring" => host_ok(call_n(string.substring, args))
    "core.string:substring_from" => host_ok(call_n(string.substring_from, args))
    "core.string:char_at" => host_ok(call_n(string.char_at, args))
    "core.string:index_of" => host_ok(call_n(string.index_of, args))
    "core.string:starts_with" => host_ok(call_n(string.starts_with, args))
    "core.string:ends_with" => host_ok(call_n(string.ends_with, args))
    "core.string:contains" => host_ok(call_n(string.contains, args))
    "core.string:length" => host_ok(call_n(string.length, args))
    "core.string:is_empty" => host_ok(call_n(string.is_empty, args))
    "core.string:repeat" => host_ok(call_n(string.repeat, args))
    "core.string:pad_left" => host_ok(call_n(string.pad_left, args))
    "core.string:pad_right" => host_ok(call_n(string.pad_right, args))
    "core.string:lines" => host_ok(call_n(string.lines, args))
    "core.string:words" => host_ok(call_n(string.words, args))
    "core.string:reverse" => host_ok(call_n(string.reverse, args))
    "core.string:from_code" => host_ok(call_n(string.from_code, args))
    "core.array:reverse" => host_ok(call_n(array.reverse, args))
    "core.array:slice" => host_ok(call_n(array.slice, args))
    "core.array:slice_from" => host_ok(call_n(array.slice_from, args))
    "core.array:index_of" => host_ok(call_n(array.index_of, args))
    "core.array:flatten" => host_ok(call_n(array.flatten, args))
    "core.array:unique" => host_ok(call_n(array.unique, args))
    "core.array:zip" => host_ok(call_n(array.zip, args))
    "core.array:take" => host_ok(call_n(array.take, args))
    "core.array:drop" => host_ok(call_n(array.drop, args))
    "core.array:sum" => host_ok(call_n(array.sum, args))
    "core.array:product" => host_ok(call_n(array.product, args))
    "core.array:any" => host_ok(call_n(array.any, args))
    "core.array:all" => host_ok(call_n(array.all, args))
    "core.array:find" => host_ok(call_n(array.find, args))
    "core.array:find_index" => host_ok(call_n(array.find_index, args))
    "core.array:count" => host_ok(call_n(array.count, args))
    "core.array:partition" => host_ok(call_n(array.partition, args))
    "core.array:sort" => host_ok(call_n(array.sort, args))
    "core.array:sort_by" => host_ok(call_n(array.sort_by, args))
    "core.array:chunk" => host_ok(call_n(array.chunk, args))
    "core.array:intersperse" => host_ok(call_n(array.intersperse, args))
    "core.array:enumerate" => host_ok(call_n(array.enumerate, args))
    "core.array:contains" => host_ok(call_n(array.contains, args))
    "core.math:abs" => host_ok(call_n(math.abs, args))
    "core.math:min" => host_ok(call_n(math.min, args))
    "core.math:max" => host_ok(call_n(math.max, args))
    "core.math:floor" => host_ok(call_n(math.floor, args))
    "core.math:ceil" => host_ok(call_n(math.ceil, args))
    "core.math:round" => host_ok(call_n(math.round, args))
    "core.math:sqrt" => host_ok(call_n(math.sqrt, args))
    "core.math:pow" => host_ok(call_n(math.pow, args))
    "core.math:sin" => host_ok(call_n(math.sin, args))
    "core.math:cos" => host_ok(call_n(math.cos, args))
    "core.math:tan" => host_ok(call_n(math.tan, args))
    "core.math:log" => host_ok(call_n(math.log, args))
    "core.math:exp" => host_ok(call_n(math.exp, args))
    "core.math:clamp" => host_ok(call_n(math.clamp, args))
    "core.math:sign" => host_ok(call_n(math.sign, args))
    "core.types:type_of" => host_ok(call_n(types.type_of, args))
    "core.types:is_int" => host_ok(call_n(types.is_int, args))
    "core.types:is_float" => host_ok(call_n(types.is_float, args))
    "core.types:is_string" => host_ok(call_n(types.is_string, args))
    "core.types:is_bool" => host_ok(call_n(types.is_bool, args))
    "core.types:is_array" => host_ok(call_n(types.is_array, args))
    "core.types:is_hash" => host_ok(call_n(types.is_hash, args))
    "core.types:is_tuple" => host_ok(call_n(types.is_tuple, args))
    "core.types:is_function" => host_ok(call_n(types.is_function, args))
    "core.types:is_number" => host_ok(call_n(types.is_number, args))
    "core.types:is_success" => host_ok(call_n(types.is_success, args))
    "core.types:is_failure" => host_ok(call_n(types.is_failure, args))
    _ => host_err(concat("unsupported host function: ", name));

func! host_say(args) = do
    io.say(vm_to_string(args[0]));
    Maybe.None
end;

// vm_to_string renders the interpreter's own wrappers the way the reference
// prints them: an ADT as `Tag(a, b)`, a zero-argument variant as `Tag`, and a
// function as `<func name>` / `<builtin name>`.
func vm_to_string(v) = match v
    AdtVal(type_name, tag, items) => adt_to_string(tag, items)
    Closure(record, frees) => concat("<func ", fn_name(record), ">")
    BuiltinFn(index) => concat("<builtin ", builtin_name(index), ">")
    HostFn(name) => concat("<builtin ", name, ">")
    _ => to_string(v);

func adt_to_string(tag, items) = match len(items) == 0
    true => tag
    false => concat(tag, "(", join_values(items, 0, len(items), ""), ")");

func join_values(items, i, n, acc) = match i >= n
    true => acc
    false => join_values(items, i + 1, n, concat(acc, value_sep(i), vm_to_string(items[i])));

func value_sep(i) = match i == 0
    true => ""
    false => ", ";
