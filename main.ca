use core.io!;
use core.os!;
use core.string;
use core.array;
use core.bytes;
use lexer;
use parser;
use formatter;
use compiler;
use serialize;
use typechecker;
use vm;
use loader;

// calcium-selfhost CLI entry point.
//
// Run with the reference interpreter:
//   calcium main.ca <command> [args]
//
// The command set is fixed by SPEC.md §2 because the differential test harness
// drives it. Adding a command is fine; changing the existing shape is not.

func version() = "0.1.0";

func usage_lines() = [
    "usage: calcium main.ca <command> [args]",
    "",
    "commands:",
    "  version                   print the candidate version",
    "  lex <in>                  dump the token stream",
    "  parse <in>                dump the AST summary (debugging only)",
    "  check <in>                dump type checker findings (debugging only)",
    "  fmt <in> -o <out>         format <in> into <out>",
    "  compile <in> -o <out>     compile <in> into <out> (.bone)",
    "  run <in>                  compile <in> and run it on the self-hosted VM"
];

func usage() = string.join(usage_lines(), "\n");

// unimplemented reports that a known command has no implementation yet and
// exits non-zero so that scripts and CI do not treat it as success.
func unimplemented(cmd) = do
    concat("calcium-selfhost: '", cmd, "' is not implemented yet (see SPEC.md)") !> io.say
    os.exit(1)
end;

// ---------------------------------------------------------------------------
// lex
// ---------------------------------------------------------------------------

// lex_escape makes a token literal safe to print on one line. The reference
// `calcium lex` applies exactly these four rules.
func lex_escape(s) = match lex_needs_escape(s)
    true => lex_escape_loop(string.split(s, ""), 0, len(s), "")
    false => s;

func lex_needs_escape(s) =
    string.contains(s, "\\") || string.contains(s, "\n") ||
    string.contains(s, "\t") || string.contains(s, "\r");

func lex_escape_loop(chars, i, n, acc) = match i >= n
    true => acc
    false => lex_escape_loop(chars, i + 1, n, concat(acc, lex_escape_one(chars[i])));

func lex_escape_one(c) = match c
    "\\" => "\\\\"
    "\n" => "\\n"
    "\t" => "\\t"
    "\r" => "\\r"
    _ => c;

func lex_line(t) = concat(
    to_string(t.line), ":", to_string(t.column), "\t",
    t.kind, "\t", lex_escape(t.literal));

// lex_print prints one token and returns the running token count.
func lex_print(t, n) = do
    lex_line(t) !> io.say
    n + 1
end;

func lex_dump(toks, n) = match lexer.first(toks)
    Maybe.None => n
    Maybe.Some(t) => lex_dump(lexer.rest(toks), lex_print(t, n));

func lex_file(path) = match io.exists(path)
    false => lex_missing(path)
    true => lex_run(path);

func lex_missing(path) = do
    concat("calcium-selfhost: cannot read ", path) !> io.say
    os.exit(1)
end;

func lex_run(path) = do
    src = io.read_file(path) !? {
        success(v) => v
        failure(e) => ""
    }
    toks = lexer.tokenize(src)
    n = lex_dump(toks, 0)
    concat("# tokens: ", to_string(n)) !> io.say
end;

// ---------------------------------------------------------------------------
// parse
// ---------------------------------------------------------------------------

// parse_file reports how many statements the input parses into. It is a
// debugging aid: the AST dump format is not part of the compatibility contract.
func parse_file(path) = do
    src = read_source(path)
    toks = lexer.tokenize(src)
    result = parser.parse_program(toks)
    concat("# statements: ", to_string(len(result.statements))) !> io.say
end;

// fmt_file writes the formatted source to the -o target. The reference `fmt`
// edits in place, which cannot be compared, so this one always writes to a file.
func fmt_file(argv) = do
    input = get(argv, 3, "")
    output = get(argv, 5, "")
    src = read_source(input)
    parsed = parser.parse_program(lexer.tokenize(src))
    io.write_file(output, formatter.format_program(parsed.statements))
end;

// compile_file writes a .bone for the input. The reference VM runs it.
func compile_file(argv) = do
    input = get(argv, 3, "")
    output = get(argv, 5, "")
    src = read_source(input)
    parsed = parser.parse_program(lexer.tokenize(src))
    st = compiler.compile_program(parsed.statements)
    match len(st.errors) == 0
        true => io.write_file(output, serialize.to_string_bytes(compiler.to_bone(st)))
        false => report_compile_errors(input, st.errors, 0, len(st.errors))
end;

// report_compile_errors prints `<file>:<line>:<col>: <message>` per diagnostic and
// exits non-zero, so a compile that found problems cannot look successful.
func report_compile_errors(path, errors, i, n) = do
    report_one_error(path, errors[i]);
    more = i + 1 < n;
    match more
        true => report_compile_errors(path, errors, i + 1, n)
        false => os.exit(1)
end;

func report_one_error(path, e) = do
    concat(path, ":", to_string(e.line), ":", to_string(e.col), ": ", e.message) !> io.say
end;

// run_file compiles the input with the self-hosted compiler and executes the
// result on the self-hosted VM. Modules are provided by the VM's own registry,
// so only programs using `core.io` can produce output.
// run_file compiles and runs the program on the self-hosted VM. Local modules
// (`use test;`) are loaded here rather than by the host: the loader reads the
// module source, compiles it with the self-hosted compiler, runs its top-level
// code on the same VM, and exposes its globals as the module's exports.
func! run_file(path) = match string.ends_with(path, ".bone")
    true => run_bone(path)
    false => run_source(path);

// finish_run reports a runtime error and exits non-zero, the way a compile error
// does. Without this the interpreter's error state was simply dropped.
func! finish_run(r) = match r.ok
    true => r.v
    false => do
        io.println(concat("runtime error: ", r.error));
        os.exit(1)
    end;

// run_bone reads a compiled program. The format is normative in
// specs/bone-format.md, and the reader lives next to the writer in `serialize`.
// A .bone has no `use` statements left to read, so only the built-in modules
// resolve; local ones need the source.
func! run_bone(path) = do
    prog = serialize.read_program(bytes.to_bytes(read_source(path)));
    match prog.ok
        true => finish_run(vm.run_with_modules(prog.constants, prog.instructions, {}))
        false => io.println(concat(path, ": not a Calcium bytecode file"))
end;

func! run_source(path) = do
    src = read_source(path)
    parsed = parser.parse_program(lexer.tokenize(src))
    st = compiler.compile_program(parsed.statements)
    match len(st.errors) == 0
        true => do
            mods = loader.load_modules(parsed.statements, path);
            finish_run(vm.run_with_modules(st.consts, st.code, mods))
        end
        false => report_compile_errors(path, st.errors, 0, len(st.errors))
end;



func check_print(findings, i, n) = match i >= n
    true => 0
    false => check_print_one(findings, i, n);

func check_print_one(findings, i, n) = do
    concat(to_string(findings[i].line), ":", to_string(findings[i].col), "\ttype") !> io.say
    check_print(findings, i + 1, n)
end;

// check_file prints one finding per line as `<line>:<column>\ttype`, matching
// `calcium check`.
func check_file(path) = do
    src = read_source(path)
    parsed = parser.parse_program(lexer.tokenize(src))
    findings = typechecker.check(parsed.statements)
    check_print(findings, 0, len(findings))
    concat(path, ": ", to_string(len(findings)), " finding(s)") !> io.say
end;

func check_print(findings, i, n) = match i >= n
    true => 0
    false => check_print_one(findings, i, n);

func check_print_one(findings, i, n) = do
    concat(to_string(findings[i].line), ":", to_string(findings[i].col), "\ttype") !> io.say
    check_print(findings, i + 1, n)
end;

func read_source(path) = io.read_file(path) !? {
    success(v) => v
    failure(e) => ""
};

// ---------------------------------------------------------------------------
// dispatch
// ---------------------------------------------------------------------------

args = os.args();

// argv is [interpreter, main.ca, command, ...] so the command is at index 2.
// Literal payload patterns keep the dispatch readable.
match get(args, 2)
    Maybe.Some("version") => concat("calcium-selfhost ", version()) !> io.say
    Maybe.Some("lex") => lex_file(get(args, 3, ""))
    Maybe.Some("parse") => parse_file(get(args, 3, ""))
    Maybe.Some("fmt") => fmt_file(args)
    Maybe.Some("compile") => compile_file(args)
    Maybe.Some("check") => check_file(get(args, 3, ""))
    Maybe.Some("run") => run_file(get(args, 3, ""))
    Maybe.Some("help") => usage() !> io.say
    Maybe.Some(cmd) => unimplemented(cmd)
    Maybe.None => do
        usage() !> io.say
        os.exit(1)
    end;
