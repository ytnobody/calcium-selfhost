// parser - tokens to an AST.
//
// A Pratt parser over the token list produced by `lexer`. The precedence table
// and the treatment of each token follow the reference implementation exactly,
// because the formatted output has to be byte-identical.
//
// The parser is a pure function: every function takes the remaining token list
// and returns a result record carrying the node and the tokens left over.

namespace parser;

use core.string;
use core.array;
use lexer;
use ast;

// ---------------------------------------------------------------------------
// Cursor
//
// The token list always ends with EOF, so `cur` needs no empty case.
// ---------------------------------------------------------------------------

func cur(toks) = match lexer.first(toks)
    Maybe.Some(t) => t
    Maybe.None => {kind: "EOF", literal: "", line: 0, column: 0};

func rest(toks) = lexer.rest(toks);
func kind(toks) = cur(toks).kind;
func lit(toks) = cur(toks).literal;
func peek_kind(toks) = kind(rest(toks));
func peek2_kind(toks) = kind(rest(rest(toks)));
func peek3_kind(toks) = kind(rest(rest(rest(toks))));

func is_kind(toks, k) = kind(toks) == k;
func at_end(toks) = is_kind(toks, "EOF");
func peek_is(toks, k) = peek_kind(toks) == k;

// starts_upper reports whether a name starts with an upper-case letter, which is
// how constructor names are recognised.
func starts_upper(s) = match len(s) == 0
    true => false
    false => _starts_upper(s);

func _starts_upper(s) = match string.char_at(s, 0)
    Maybe.Some(c) => _is_upper_char(c)
    Maybe.None => false;

func _is_upper_char(c) =
    c == "A" || c == "B" || c == "C" || c == "D" || c == "E" || c == "F" ||
    c == "G" || c == "H" || c == "I" || c == "J" || c == "K" || c == "L" ||
    c == "M" || c == "N" || c == "O" || c == "P" || c == "Q" || c == "R" ||
    c == "S" || c == "T" || c == "U" || c == "V" || c == "W" || c == "X" ||
    c == "Y" || c == "Z";

// ---------------------------------------------------------------------------
// Precedence
// ---------------------------------------------------------------------------

func prec(k) = match k
    "=>" => 2
    "|>" => 3
    "|>?" => 3
    "!>" => 3
    "!!!>" => 3
    "!?" => 3
    "||" => 4
    "&&" => 5
    "==" => 6
    "!=" => 6
    "~" => 6
    "<" => 7
    ">" => 7
    "<=" => 7
    ">=" => 7
    "+" => 8
    "-" => 8
    "|" => 8
    "^" => 8
    "*" => 9
    "/" => 9
    "%" => 9
    "<<" => 9
    ">>" => 9
    "&" => 9
    "**" => 10
    "(" => 12
    "[" => 13
    "." => 14
    "..." => 15
    "?" => 15
    _ => 1;

func res(e, toks) = {e: e, t: toks};

// ---------------------------------------------------------------------------
// Program and statements
// ---------------------------------------------------------------------------

func parse_program(toks) = parse_statements(toks, []);

func parse_statements(toks, acc) = match kind(toks)
    "EOF" => {statements: acc, t: toks}
    _ => parse_statements_next(toks, acc);

func parse_statements_next(toks, acc) = do
    r = parse_statement(toks)
    after = match same_pos(r.t, toks)
        true => rest(toks)
        false => r.t
    parse_statements(after, push(acc, r.s))
end;

// same_pos reports whether two cursors point at the same token, which is how a
// parser that consumed nothing is detected.
func same_pos(a, b) = cur(a).line == cur(b).line && cur(a).column == cur(b).column && cur(a).kind == cur(b).kind;

func parse_statement(toks) = match kind(toks)
    "USE" => parse_use(toks)
    "NAMESPACE" => parse_namespace(toks)
    "TYPE" => parse_type_decl(toks)
    "CONSTRAINT" => parse_constraint_decl(toks)
    "FUNC" => parse_func_decl(toks, false)
    "FUNC!" => parse_func_decl(toks, true)
    _ => parse_statement_other(toks);

func parse_statement_other(toks) = match peek_kind(toks) == "=" && kind(toks) == "IDENT"
    true => parse_assignment(toks)
    false => parse_statement_rest(toks);

func parse_statement_rest(toks) = match kind(toks) == "["
    true => parse_bracket_statement(toks)
    false => parse_expression_statement(toks);

// `use a.b!;` — the `!` is a separate token.
func parse_use(toks) = do
    path = module_path(rest(toks))
    after = path.t
    effect = is_kind(after, "!")
    after2 = match effect
        true => rest(after)
        false => after
    after3 = match is_kind(after2, ";")
        true => rest(after2)
        false => after2
    {s: ast.SUse(path.text, effect), t: after3}
end;

func parse_namespace(toks) = do
    path = module_path(rest(toks))
    after = match is_kind(path.t, ";")
        true => rest(path.t)
        false => path.t
    {s: ast.SNamespace(path.text), t: after}
end;

// module_path reads `ident (. ident)*` and returns its dotted text. The cursor
// it returns must be the token *after* the path; returning the first token made
// `namespace bytes;` parse as two statements.
func module_path(toks) = module_path_more(lit(toks), rest(toks));

func module_path_more(text, toks) = match is_kind(toks, ".")
    true => module_path_more(concat(text, ".", lit(rest(toks))), rest(rest(toks)))
    false => {text: text, t: toks};

func parse_assignment(toks) = do
    name = lit(toks)
    r = parse_expression(rest(rest(toks)), 1)
    after = eat_semicolon(r.t)
    {s: ast.SAssign(name, r.e), t: after}
end;

func eat_semicolon(toks) = match is_kind(toks, ";")
    true => rest(toks)
    false => toks;

func parse_expression_statement(toks) = do
    r = parse_expression(toks, 1)
    after = eat_semicolon(r.t)
    {s: ast.SExpr(r.e), t: after}
end;

func parse_func_decl(toks, is_effect) = do
    name = lit(rest(toks))
    open = rest(rest(toks))
    params = parse_params(open)
    annotated = parse_return_annotation(params.t)
    body_start = expect(annotated.t, "=")
    r = parse_expression(body_start, 1)
    after = eat_semicolon(r.t)
    {s: ast.SFunc(name, params.names, params.constraints, params.types, annotated.c, r.e, is_effect), t: after}
end;

// A return annotation (`: Int`, `: Positive`, `: A & B`). The formatter does not
// print it, but the compiler needs a constraint name for the return check; a
// built-in type name is not a constraint and is dropped.
func parse_return_annotation(toks) = match is_kind(toks, ":")
    true => parse_return_annotation_name(rest(toks))
    false => {c: "", t: toks};

func parse_return_annotation_name(toks) = do
    first = lit(toks)
    parts = parse_composite(rest(toks), first, false)
    after = skip_question(parts.t)
    // A return annotation is kept even when it is a built-in type name: the
    // compiler enforces it as a constraint and skips names it cannot resolve.
    {c: parts.text, t: after}
end;

func skip_question(toks) = match is_kind(toks, "?")
    true => rest(toks)
    false => toks;

// parse_params reads `(a, b: C?, c)`.
func parse_params(toks) = parse_params_from(rest(toks), [], [], []);

func parse_params_from(toks, names, constraints, types) = match is_kind(toks, ")") || at_end(toks)
    true => {names: names, constraints: constraints, types: types, t: rest(toks)}
    false => parse_params_one(toks, names, constraints, types);

func parse_params_one(toks, names, constraints, types) = do
    name = lit(toks)
    parsed = parse_annotation(rest(toks))
    names2 = push(names, name)
    cons2 = push(constraints, parsed.c)
    types2 = push(types, parsed.ty)
    next = match is_kind(parsed.t, ",")
        true => rest(parsed.t)
        false => parsed.t
    parse_params_from(next, names2, cons2, types2)
end;

// A parameter annotation is either a built-in type or a constraint. The
// reference formatter drops type annotations (`a: Int` prints as `a`) but keeps
// constraints, always with a `?` (`a: Positive` prints as `a: Positive?`). A
// built-in type followed by `?` is treated as a constraint instead, matching the
// reference.
func parse_param_constraint(toks) = match is_kind(toks, ":")
    true => parse_annotation(rest(toks))
    false => {c: "", t: toks};

// parse_annotation distinguishes a built-in type annotation (`a: Int`, kept in
// `ty`) from a constraint (`a: Positive?`, kept in `c`). The formatter prints
// only constraints, but the compiler enforces both at run time.
// parse_annotation returns the cursor unchanged when there is no `:`, so a
// parameter without an annotation does not consume the delimiter.
func parse_annotation(toks) = match is_kind(toks, ":")
    true => parse_annotation_body(rest(toks))
    false => {c: "", ty: "", t: toks};

func parse_annotation_body(toks) = do
    first = lit(toks)
    parts = parse_composite(rest(toks), first, false)
    has_q = is_kind(parts.t, "?")
    after = match has_q
        true => rest(parts.t)
        false => parts.t
    {c: annotation_text(first, parts.text, parts.composite, has_q),
     ty: annotation_type(first, parts.composite, has_q), t: after}
end;

func annotation_type(first, composite, has_q) = match !composite && !has_q && is_builtin_type(first)
    true => first
    false => "";

// parse_composite accumulates `A & B` / `A | B` into one textual annotation.
func parse_composite(toks, text, composite) = match is_kind(toks, "&") || is_kind(toks, "|")
    true => parse_composite(rest(rest(toks)), concat(text, " ", lit(toks), " ", lit(rest(toks))), true)
    false => {text: text, composite: composite, t: toks};

func annotation_text(first, text, composite, has_q) = match !composite && !has_q && is_builtin_type(first)
    true => ""
    false => text;

func is_builtin_type(name) = match name
    "Any" => true
    "Maybe" => true
    "Secret" => true
    "Bool" => true
    "Int" => true
    "Float" => true
    "String" => true
    "Array" => true
    "Hash" => true
    "Tuple" => true
    "Func" => true
    "Regex" => true
    "Success" => true
    "Failure" => true
    _ => false;

func parse_type_decl(toks) = do
    name = lit(rest(toks))
    after_eq = expect(rest(rest(toks)), "=")
    variants = parse_variants(after_eq, [])
    after = match is_kind(variants.t, ";")
        true => rest(variants.t)
        false => variants.t
    {s: ast.SType(name, variants.vs), t: after}
end;

func parse_variants(toks, acc) = do
    name = lit(toks)
    fields = parse_variant_fields(rest(toks))
    acc2 = push(acc, ast.Variant(name, fields.fields))
    next = match is_kind(fields.t, "|")
        true => rest(fields.t)
        false => fields.t
    more = is_kind(fields.t, "|")
    loop(more, next, acc2)
end;

func loop(more, next, acc) = match more
    true => parse_variants(next, acc)
    false => {vs: acc, t: next};

func parse_variant_fields(toks) = match is_kind(toks, "(")
    true => parse_variant_fields_from(rest(toks), [])
    false => {fields: [], t: toks};

func parse_variant_fields_from(toks, acc) = match is_kind(toks, ")") || at_end(toks)
    true => {fields: acc, t: rest(toks)}
    false => parse_variant_fields_one(toks, acc);

func parse_variant_fields_one(toks, acc) = do
    acc2 = push(acc, lit(toks))
    next = match is_kind(rest(toks), ",")
        true => rest(rest(toks))
        false => rest(toks)
    parse_variant_fields_from(next, acc2)
end;

func parse_constraint_decl(toks) = do
    name = lit(rest(toks))
    params = parse_constraint_params(rest(rest(rest(toks))), [])
    body_start = expect(params.t, "=")
    r = parse_expression(body_start, 1)
    after = eat_semicolon(r.t)
    {s: ast.SConstraint(name, params.names, r.e), t: after}
end;

func parse_constraint_params(toks, acc) = match is_kind(toks, ")") || at_end(toks)
    true => {names: acc, t: rest(toks)}
    false => parse_constraint_params_one(toks, acc);

func parse_constraint_params_one(toks, acc) = do
    acc2 = push(acc, lit(toks))
    next = match is_kind(rest(toks), ",")
        true => rest(rest(toks))
        false => rest(toks)
    parse_constraint_params(next, acc2)
end;

// `[a, b] = v` and `[h | t] = v` versus an array literal expression.
func parse_bracket_statement(toks) = match peek_kind(toks) == "IDENT" && peek2_kind(toks) == "|"
    true => parse_head_tail(toks)
    false => parse_bracket_rest(toks);

func parse_bracket_rest(toks) = match peek_kind(toks) == "IDENT" && peek2_kind(toks) == ","
    true => parse_array_destr(toks)
    false => parse_destructure_or_expr(toks);

func parse_destructure_or_expr(toks) = match peek2_kind(toks) == "]"
    true => parse_array_destr_or_expr(toks)
    false => parse_expression_statement(toks);

// `[a] = v` is also destructuring.
func parse_array_destr_or_expr(toks) = match peek3_kind(toks) == "="
    true => parse_array_destr(toks)
    false => parse_expression_statement(toks);

func parse_head_tail(toks) = do
    head = lit(rest(toks))
    tail = lit(rest(rest(rest(toks))))
    after = expect(rest(rest(rest(rest(toks)))), "]")
    eq = expect(after, "=")
    r = parse_expression(eq, 1)
    {s: ast.SHeadTailDestr(head, tail, r.e), t: eat_semicolon(r.t)}
end;

func parse_array_destr(toks) = do
    names = parse_destr_names(rest(toks), [])
    eq = expect(names.t, "=")
    r = parse_expression(eq, 1)
    {s: ast.SArrayDestr(names.names, r.e), t: eat_semicolon(r.t)}
end;

func parse_destr_names(toks, acc) = match is_kind(toks, "]") || at_end(toks)
    true => {names: acc, t: rest(toks)}
    false => parse_destr_names_one(toks, acc);

func parse_destr_names_one(toks, acc) = do
    acc2 = push(acc, lit(toks))
    next = match is_kind(rest(toks), ",")
        true => rest(rest(toks))
        false => rest(toks)
    parse_destr_names(next, acc2)
end;

func expect(toks, k) = match is_kind(toks, k)
    true => rest(toks)
    false => toks;

// ---------------------------------------------------------------------------
// Expressions
//
// parse_expression(toks, min_prec) parses a prefix expression and then applies
// infix operators whose precedence is above min_prec, left-associatively.
// ---------------------------------------------------------------------------

func parse_expression(toks, min_prec) = do
    p = parse_prefix(toks)
    parse_infix(p.e, p.t, min_prec)
end;

func parse_infix(left, toks, min_prec) = match prec(kind(toks)) > min_prec
    true => parse_infix_op(left, toks, min_prec)
    false => res(left, toks);

func parse_infix_op(left, toks, min_prec) = do
    r = parse_infix_for(left, toks, min_prec)
    parse_infix(r.e, r.t, min_prec)
end;

func parse_prefix(toks) = match is_stay(toks)
    true => parse_stay(toks)
    false => parse_prefix_secret(toks);

func parse_prefix_secret(toks) = match is_secret_with(toks)
    true => parse_secret_with(toks)
    false => parse_prefix_rest(toks);

// async.stay(name: value, ...) { ... } is its own construct, not a call with a
// trailing block: its "arguments" are name/value pairs, so the ordinary call
// parser would choke on the colon.
func is_stay(toks) = kind(toks) == "IDENT" && lit(toks) == "async" &&
    peek_kind(toks) == "." && lit(rest(rest(toks))) == "stay" && peek3_kind(toks) == "(";

func parse_prefix_rest(toks) = match kind(toks)
    "INT" => res(ast.EInt(lit(toks)), rest(toks))
    "FLOAT" => res(ast.EFloat(lit(toks)), rest(toks))
    "STRING" => res(ast.EStr(lit(toks)), rest(toks))
    "REGEX" => res(ast.ERegex(lit(toks)), rest(toks))
    "TRUE" => res(ast.EBool(true), rest(toks))
    "FALSE" => res(ast.EBool(false), rest(toks))
    "_" => res(ast.EWild, rest(toks))
    "IDENT" => res(ast.EIdent(lit(toks)), rest(toks))
    "MAP" => res(ast.EIdent("map"), rest(toks))
    "FILTER" => res(ast.EIdent("filter"), rest(toks))
    "REDUCE" => res(ast.EIdent("reduce"), rest(toks))
    "HAS" => res(ast.EIdent("has"), rest(toks))
    "KEYS" => res(ast.EIdent("keys"), rest(toks))
    "VALUES" => res(ast.EIdent("values"), rest(toks))
    "HASH" => res(ast.EIdent("hash"), rest(toks))
    "LEN" => res(ast.EIdent("len"), rest(toks))
    "-" => parse_prefix_op(toks)
    "!" => parse_prefix_op(toks)
    "^" => parse_prefix_op(toks)
    "(" => parse_group(toks)
    "[" => parse_array(toks)
    "{" => parse_hash(toks)
    "MATCH" => parse_match(toks)
    "SUCCESS" => parse_success(toks)
    "FAILURE" => parse_failure(toks)
    "RETURN" => parse_return(toks)
    "DO" => parse_do(toks)
    "STRING_TEMPLATE_START" => parse_interpolated(toks)
    // Unrecognised token: consume it so the enclosing loop always advances. A
    // wildcard is the least surprising placeholder, and the formatter prints it
    // as `_`, which makes the gap visible instead of hanging.
    _ => res(ast.EWild, rest(toks));

func parse_prefix_op(toks) = do
    op = lit(toks)
    r = parse_expression(rest(toks), 11)
    res(ast.EPrefix(op, r.e), r.t)
end;

func parse_success(toks) = do
    r = parse_expression(rest(rest(toks)), 1)
    res(ast.ESuccess(r.e), expect(r.t, ")"))
end;

func parse_failure(toks) = do
    r = parse_expression(rest(rest(toks)), 1)
    res(ast.EFailure(r.e), expect(r.t, ")"))
end;

func parse_return(toks) = do
    r = parse_expression(rest(toks), 1)
    res(ast.EReturn(r.e), r.t)
end;

// `()` is only meaningful as an empty parameter list, so `() => body` is the one
// form that starts this way.
func parse_group(toks) = match is_kind(rest(toks), ")")
    true => parse_empty_group(toks)
    false => parse_group_nonempty(toks);

func parse_empty_group(toks) = match peek2_kind(toks) == "=>"
    true => parse_empty_lambda(rest(rest(rest(toks))))
    false => res(ast.ETuple([]), rest(rest(toks)));

func parse_empty_lambda(toks) = do
    r = parse_expression(toks, 1)
    res(ast.ELambda([], r.e), r.t)
end;

// `(expr)`, `(a, b)` or `(a, b) => body`.
func parse_group_nonempty(toks) = do
    r = parse_expression(rest(toks), 1)
    match is_kind(r.t, ")") && peek_is(r.t, "=>")
        true => parse_lambda_body(r.e, rest(rest(r.t)))
        false => parse_group_rest(r)
end;

func parse_group_rest(r) = match is_kind(r.t, ",")
    true => parse_tuple(rest(r.t), push([], r.e))
    false => res(r.e, expect(r.t, ")"));

func parse_tuple(toks, acc) = do
    r = parse_expression(toks, 1)
    acc2 = push(acc, r.e)
    more = is_kind(r.t, ",")
    next = match more
        true => rest(r.t)
        false => r.t
    match more
        true => parse_tuple(next, acc2)
        false => res(ast.ETuple(acc2), expect(r.t, ")"))
end;

// `x => body` or `(a, b) => body`.
func parse_lambda_body(params, toks) = do
    r = parse_expression(toks, 1)
    res(ast.ELambda(param_names(params), r.e), r.t)
end;

func param_names(e) = match e
    Expr.EIdent(name) => [name]
    Expr.ETuple(elements) => map_names(elements, 0, len(elements), [])
    _ => ["_"];

func map_names(es, i, n, acc) = match i >= n
    true => acc
    false => map_names(es, i + 1, n, push(acc, param_name(es[i])));

func param_name(e) = match e
    Expr.EIdent(name) => name
    _ => "_";

func parse_array(toks) = parse_array_items(rest(toks), [], false);

func parse_array_items(toks, acc, is_concat) = match is_kind(toks, "]") || at_end(toks)
    true => res(ast.EArray(acc, is_concat), rest(toks))
    false => parse_array_item(toks, acc, is_concat);

func parse_array_item(toks, acc, is_concat) = do
    r = parse_expression(toks, 1)
    acc2 = push(acc, r.e)
    match is_kind(r.t, ",")
        true => parse_array_items(rest(r.t), acc2, is_concat)
        false => parse_array_tail(r.t, acc2, is_concat)
end;

func parse_array_tail(toks, acc, is_concat) = match is_kind(toks, "]")
    true => res(ast.EArray(acc, is_concat), rest(toks))
    false => parse_array_items(toks, acc, true);

func parse_hash(toks) = parse_hash_pairs(rest(toks), []);

func parse_hash_pairs(toks, acc) = match is_kind(toks, "}") || at_end(toks)
    true => res(ast.EHash(acc), rest(toks))
    false => parse_hash_pair(toks, acc);

func parse_hash_pair(toks, acc) = do
    key = parse_hash_key(toks)
    colon = expect(key.t, ":")
    value = parse_expression(colon, 1)
    acc2 = push(acc, ast.HashPair(key.e, value.e))
    next = match is_kind(value.t, ",")
        true => rest(value.t)
        false => value.t
    parse_hash_pairs(next, acc2)
end;

func parse_hash_key(toks) = match kind(toks) == "IDENT" && peek_kind(toks) == ":"
    true => res(ast.EStr(lit(toks)), rest(toks))
    false => parse_expression(toks, 1);

// `"a ${expr} b"`
func parse_interpolated(toks) = parse_interp_parts(rest(toks), [ast.EStr(lit(toks))], "STRING_TEMPLATE_MIDDLE");

func parse_interp_parts(toks, acc, expected) = match is_kind(toks, expected)
    true => parse_interp_expr(toks, push(acc, ast.EStr(lit(toks))))
    false => res(ast.EInterp(acc), toks);

func parse_interp_expr(toks, acc) = do
    r = parse_expression(rest(toks), 1)
    next = match is_kind(r.t, "STRING_TEMPLATE_MIDDLE")
        true => "STRING_TEMPLATE_MIDDLE"
        false => "STRING_TEMPLATE_END"
    parse_interp_tail(r.t, push(acc, r.e), next)
end;

func parse_interp_tail(toks, acc, expected) = match is_kind(toks, expected)
    true => parse_interp_parts_after(toks, push(acc, ast.EStr(lit(toks))), expected)
    false => res(ast.EInterp(acc), toks);

func parse_interp_parts_after(toks, acc, expected) = match expected == "STRING_TEMPLATE_MIDDLE"
    true => parse_interp_expr(toks, acc)
    false => res(ast.EInterp(acc), rest(toks));

// `match subject` followed by `pattern => body` arms.
func parse_match(toks) = do
    subject = parse_expression(rest(toks), 1)
    cases = parse_cases(subject.t, [])
    res(ast.EMatch(subject.e, cases.cases), cases.t)
end;

func parse_cases(toks, acc) = match case_ends(toks)
    true => {cases: acc, t: toks}
    false => parse_case(toks, acc);

// A case list ends at a delimiter or at a closing keyword.
func case_ends(toks) = match kind(toks)
    "EOF" => true
    ";" => true
    ")" => true
    "]" => true
    "}" => true
    "," => true
    "end" => true
    _ => false;

func parse_case(toks, acc) = do
    p = parse_case_pattern(toks)
    guard = parse_case_guard(p.t)
    arrow = expect(guard.t, "=>")
    body = parse_expression(arrow, 2)
    is_default = case_is_wild(p.e)
    acc2 = push(acc, ast.Case(p.e, guard.g, body.e, is_default))
    parse_cases(body.t, acc2)
end;

func case_is_wild(e) = match e
    Expr.EWild => true
    _ => false;

func parse_case_guard(toks) = match kind(toks) == "IDENT" && lit(toks) == "if"
    true => do
        r = parse_expression(rest(toks), 2)
        {g: r.e, t: r.t}
    end
    false => {g: ast.EWild, t: toks};

func parse_case_pattern(toks) = match kind(toks) == "_"
    true => res(ast.EWild, rest(toks))
    false => parse_case_pattern_rest(toks);

func parse_case_pattern_rest(toks) = match kind(toks) == "IDENT" && starts_upper(lit(toks)) && peek_kind(toks) == "."
    true => parse_qualified_pattern(toks)
    false => parse_case_pattern_ctor(toks);

func parse_case_pattern_ctor(toks) = match kind(toks) == "IDENT" && starts_upper(lit(toks)) && peek_kind(toks) == "("
    true => parse_ctor_pattern(toks, "")
    false => do
        r = parse_expression(toks, 2)
        res(r.e, r.t)
    end;

func parse_qualified_pattern(toks) = do
    type_name = lit(toks)
    name = lit(rest(rest(toks)))
    after = rest(rest(rest(toks)))
    match is_kind(after, "(")
        true => parse_ctor_fields(type_name, name, rest(after), [])
        false => res(ast.EConstructorPattern(type_name, name, []), after)
end;

func parse_ctor_pattern(toks, type_name) = do
    name = lit(toks)
    parse_ctor_fields(type_name, name, rest(rest(toks)), [])
end;

func parse_ctor_fields(type_name, name, toks, acc) = match is_kind(toks, ")") || at_end(toks)
    true => res(ast.EConstructorPattern(type_name, name, acc), rest(toks))
    false => parse_ctor_field(type_name, name, toks, acc);

func parse_ctor_field(type_name, name, toks, acc) = do
    field = parse_case_pattern(toks)
    acc2 = push(acc, field.e)
    next = match is_kind(field.t, ",")
        true => rest(field.t)
        false => field.t
    parse_ctor_fields(type_name, name, next, acc2)
end;

// ---------------------------------------------------------------------------
// Infix
// ---------------------------------------------------------------------------

func parse_infix_for(left, toks, min_prec) = match kind(toks)
    "(" => parse_call_tail(left, rest(toks), [])
    "[" => do
        r = parse_expression(rest(toks), 1)
        res(ast.EIndex(left, r.e), expect(r.t, "]"))
    end
    "." => res(ast.EMember(left, lit(rest(toks))), rest(rest(toks)))
    "=>" => parse_lambda_body(left, rest(toks))
    "|>" => pipe_binary(left, toks)
    "!>" => effect_pipe(left, toks, false)
    "!!!>" => effect_pipe(left, toks, true)
    "|>?" => error_pipe_binary(left, toks)
    "<" => relational(left, toks)
    ">" => relational(left, toks)
    "<=" => relational(left, toks)
    ">=" => relational(left, toks)
    "..." => res(ast.ESpread(left), rest(toks))
    "?" => res(ast.EConstraintCheck(left), rest(toks))
    "!?" => parse_effect_handle(left, rest(toks))
    _ => infix_binary(left, toks);

// `f(a, b)`
func parse_call_tail(fn, toks, acc) = match is_kind(toks, ")") || at_end(toks)
    true => res(ast.ECall(fn, acc), rest(toks))
    false => parse_call_arg(fn, toks, acc);

func parse_call_arg(fn, toks, acc) = do
    r = parse_expression(toks, 1)
    acc2 = push(acc, r.e)
    next = match is_kind(r.t, ",")
        true => rest(r.t)
        false => r.t
    parse_call_tail(fn, next, acc2)
end;

// `**` is right-associative; everything else is left-associative, which is what
// passing the operator's own precedence to the recursive call gives.
func infix_binary(left, toks) = do
    op = lit(toks)
    r = parse_expression(rest(toks), right_prec(prec(op), op))
    res(ast.EInfix(op, left, r.e), r.t)
end;

// A chained comparison `a <= b <= c` is expanded to `(a <= b) && (b <= c)`,
// which is what the reference parser does; `==` and `!=` do not chain.
func relational(left, toks) = do
    op = lit(toks)
    r = parse_expression(rest(toks), prec(op))
    chain(ast.EInfix(op, left, r.e), r.e, r.t)
end;

func chain(combined, middle, toks) = match is_comparison(kind(toks))
    true => do
        op = lit(toks)
        r = parse_expression(rest(toks), prec(op))
        right = ast.EInfix(op, middle, r.e)
        chain(ast.EInfix("&&", combined, right), r.e, r.t)
    end
    false => res(combined, toks);

func is_comparison(k) = k == "<" || k == ">" || k == "<=" || k == ">=";

func pipe_binary(left, toks) = do
    r = parse_expression(rest(toks), 3)
    res(ast.EPipe(left, r.e), r.t)
end;

func error_pipe_binary(left, toks) = do
    r = parse_expression(rest(toks), 3)
    res(ast.EErrorPipe(left, r.e), r.t)
end;

func right_prec(p, op) = match op == "**"
    true => p - 1
    false => p;

func effect_pipe(left, toks, allow_secret) = do
    r = parse_expression(rest(toks), 3)
    res(ast.EEffectPipe(left, r.e, allow_secret), r.t)
end;

// `subject !? { success(v) => a  failure(e) => b }`
func parse_effect_handle(subject, toks) = do
    open = expect(toks, "{")
    first = parse_handler_case(open)
    second = parse_handler_case(first.t)
    close = expect(second.t, "}")
    {e: ast.EEffectHandle(subject, first.name, first.body, second.name, second.body), t: close}
end;

func parse_handler_case(toks) = do
    name = lit(rest(rest(toks)))
    after_close = expect(rest(rest(rest(toks))), ")")
    arrow = expect(after_close, "=>")
    body = parse_expression(arrow, 2)
    {name: name, body: body.e, t: body.t}
end;

// Secret.with(capability) { ... } is a scoped block like async.stay, not a call
// with a trailing block.
func is_secret_with(toks) = kind(toks) == "IDENT" && lit(toks) == "Secret" &&
    peek_kind(toks) == "." && lit(rest(rest(toks))) == "with" && peek3_kind(toks) == "(";

func parse_secret_with(toks) = do
    open = rest(rest(rest(toks)))
    cap = parse_expression(rest(open), 1)
    body_open = expect(expect(cap.t, ")"), "{")
    body = parse_block_statements(body_open, [])
    res(ast.ESecretWith(cap.e, do_init(body.ss), do_final(body.ss)), body.t)
end;

func parse_stay(toks) = do
    open = rest(rest(rest(toks)))
    init = parse_state_pairs(rest(open), [])
    body_open = expect(init.t, "{")
    body = parse_block_statements(body_open, [])
    res(ast.EStay(init.pairs, body.ss), body.t)
end;

func parse_state_pairs(toks, acc) = match is_kind(toks, ")") || at_end(toks)
    true => {pairs: acc, t: rest(toks)}
    false => parse_state_pair(toks, acc);

func parse_state_pair(toks, acc) = do
    name = lit(toks)
    colon = expect(rest(toks), ":")
    value = parse_expression(colon, 1)
    acc2 = push(acc, ast.StatePair(name, value.e))
    next = match is_kind(value.t, ",")
        true => rest(value.t)
        false => value.t
    parse_state_pairs(next, acc2)
end;

// parse_block_statements collects statements up to a closing brace.
func parse_block_statements(toks, acc) = match is_kind(toks, "}") || at_end(toks)
    true => {ss: acc, t: rest(toks)}
    false => do
        r = parse_statement(toks)
        parse_block_statements(r.t, push(acc, r.s))
    end;

// `do ... end`
//
// The last statement is the block's value; the ones before it are evaluated for
// their effect. Both are kept apart because that is how the formatter and the
// compiler see them.
func parse_do(toks) = split_do(parse_do_body(rest(toks), []));

func parse_do_body(toks, acc) = match kind(toks) == "end" || at_end(toks)
    true => {ss: acc, t: rest(toks)}
    false => parse_do_statement(toks, acc);

func parse_do_statement(toks, acc) = do
    r = parse_statement(toks)
    parse_do_body(r.t, push(acc, r.s))
end;

func split_do(r) = {e: ast.EDo(do_init(r.ss), do_final(r.ss)), t: r.t};

// do_init returns every statement but the last.
func do_init(ss) = match len(ss) <= 1
    true => []
    false => do_take(ss, len(ss) - 1, 0, []);

func do_take(ss, n, i, acc) = match i >= n
    true => acc
    false => do_take(ss, n, i + 1, push(acc, ss[i]));

func do_final(ss) = match len(ss) == 0
    true => ast.EWild
    false => do_final_expr(ss[len(ss) - 1]);

func do_final_expr(s) = match s
    Stmt.SExpr(e) => e
    _ => ast.EWild;
