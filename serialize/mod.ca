// serialize - write a compiled program as .bone bytes.
//
// The format is normative in specs/bone-format.md: magic "CALB", a 1.1 version,
// a big-endian constant pool, then the instruction stream. Every multi-byte
// integer in the body is big-endian; only the standalone-executable trailer in
// `calcium build` is little-endian, and that envelope is not built here.

namespace serialize;

use core.array;
use core.bytes;

// ---------------------------------------------------------------------------
// Constants
//
// A constant pool entry is a tagged value. Only the kinds that have a tag in the
// format can appear here; arrays, tuples and hashes are built at run time.
// ---------------------------------------------------------------------------

type Constant =
    CBool(value) |
    CInt(value) |
    CFloat(value) |
    CStr(value) |
    CFunc(record) |
    CAdt(type_name, tag, items) |
    CRegex(pattern, flags);

// FunctionRecord is one function constant: everything the format stores about a
// function, including its own instruction stream.
type FunctionRecord = FunctionRecord(name, module_id, params, num_locals, is_effect, body);

_TAG_BOOL = 1;
_TAG_INT = 2;
_TAG_FLOAT = 3;
_TAG_STRING = 4;
_TAG_FUNCTION = 5;
_TAG_REGEX = 6;
_TAG_ADT = 7;

// ---------------------------------------------------------------------------
// Primitives
// ---------------------------------------------------------------------------

// `/` is floating-point division in Calcium, so the encoders extract bytes with
// shifts and masks. That keeps every value an int, which the byte primitives
// require.
func u8(n) = [n & 255];

func u16(n) = [(n >> 8) & 255, n & 255];

func u32(n) = [(n >> 24) & 255, (n >> 16) & 255, (n >> 8) & 255, n & 255];

// str_bytes writes a string as its byte length followed by the bytes.
func str_bytes(s) = concat_bytes(u32(bytes.byte_len(s)), bytes.to_bytes(s));

// concat_bytes appends b to a, returning a new byte array.
func concat_bytes(a, b) = concat_into(copy_list(a, 0, len(a), []), b, 0, len(b));

func copy_list(a, i, n, acc) = match i >= n
    true => acc
    false => copy_list(a, i + 1, n, push(acc, a[i]));

func concat_into(acc, b, i, n) = match i >= n
    true => acc
    false => concat_into(push(acc, b[i]), b, i + 1, n);

// ---------------------------------------------------------------------------
// Constant encoding
// ---------------------------------------------------------------------------

func encode_constant(c) = match c
    Constant.CBool(value) => concat_bytes(u8(_TAG_BOOL), u8(bool_byte(value)))
    Constant.CInt(value) => concat_bytes(u8(_TAG_INT), i64_bytes(value))
    Constant.CFloat(value) => concat_bytes(u8(_TAG_FLOAT), bytes.from_float(value))
    Constant.CStr(value) => concat_bytes(u8(_TAG_STRING), str_bytes(value))
    Constant.CFunc(record) => concat_bytes(u8(_TAG_FUNCTION), encode_function(record))
    Constant.CAdt(type_name, tag, items) => encode_adt(type_name, tag, items)
    Constant.CRegex(pattern, flags) => encode_regex(pattern, flags)
    _ => [];

// encode_adt writes an ADT constant: type name, tag, value count, values.
func encode_adt(type_name, tag, items) = concat_bytes(u8(_TAG_ADT),
    concat_bytes(concat_bytes(str_bytes(type_name), str_bytes(tag)),
        concat_bytes(u32(len(items)), encode_constants(items, 0, len(items), []))));

// encode_regex stores the Calcium pattern and its flags; the reader rebuilds the
// native regex from them.
func encode_regex(pattern, flags) = concat_bytes(u8(_TAG_REGEX),
    concat_bytes(str_bytes(pattern), str_bytes(flags)));

func bool_byte(value) = match value
    true => 1
    false => 0;

// i64_bytes is the eight big-endian two's-complement bytes of an integer.
func i64_bytes(v) = bytes.from_int(v);

func encode_function(r) = match r
    FunctionRecord.FunctionRecord(name, module_id, params, num_locals, is_effect, body) =>
        encode_function_fields(name, module_id, params, num_locals, is_effect, body)
    _ => [];

func encode_function_fields(name, module_id, params, num_locals, is_effect, body) = concat_bytes(
    concat_bytes(str_bytes(name), str_bytes(module_id)),
    concat_bytes(
        concat_bytes(u32(len(params)), encode_params(params, 0, len(params), [])),
        concat_bytes(
            concat_bytes(u32(num_locals), u8(bool_byte(is_effect))),
            concat_bytes(u32(len(body)), body))));

func encode_params(params, i, n, acc) = match i >= n
    true => acc
    false => encode_params(params, i + 1, n, concat_bytes(acc, str_bytes(params[i])));

// ---------------------------------------------------------------------------
// Program
// ---------------------------------------------------------------------------

func encode_program(constants, instructions) = concat_bytes(
    magic(),
    concat_bytes(
        u8(1),
        concat_bytes(
            u8(1),
            concat_bytes(
                concat_bytes(u32(len(constants)), encode_constants(constants, 0, len(constants), [])),
                concat_bytes(u32(len(instructions)), instructions)))));

func magic() = [67, 65, 76, 66];

func encode_constants(cs, i, n, acc) = match i >= n
    true => acc
    false => encode_constants(cs, i + 1, n, concat_bytes(acc, encode_constant(cs[i])));

// to_string_bytes turns the encoded bytes back into a string, which is what
// gets written to disk.
func to_string_bytes(bs) = bytes.from_bytes(bs);

// ---------------------------------------------------------------------------
// Reading
//
// The reader mirrors the writer above. A .bone file is the only input the
// self-hosted toolchain cannot produce itself, so `run <file.bone>` needs this.
// ---------------------------------------------------------------------------

// read_program parses the header and body; `ok` is false when the magic or the
// version does not match, which is how a wrong file is reported.
func read_program(bs) = match len(bs) < 10 || !has_magic(bs)
    true => {ok: false, constants: [], instructions: []}
    false => read_body(bs, 6);

func has_magic(bs) = bs[0] == 67 && bs[1] == 65 && bs[2] == 76 && bs[3] == 66;

func read_body(bs, i) = do
    nconstants = rd_u32(bs, i);
    cs = rd_constants(bs, i + 4, nconstants, []);
    total = rd_u32(bs, cs.i);
    {ok: true, constants: cs.items, instructions: slice(bs, cs.i + 4, cs.i + 4 + total)}
end;

func slice(arr, from, to) = slice_into(arr, from, to, []);

func slice_into(arr, from, to, acc) = match from >= to || from >= len(arr)
    true => acc
    false => slice_into(arr, from + 1, to, push(acc, arr[from]));

func rd_u32(bs, i) = bs[i] * 16777216 + bs[i + 1] * 65536 + bs[i + 2] * 256 + bs[i + 3];

// rd_i64 rebuilds a two's-complement 64-bit integer. The top byte is signed so the
// running value stays inside a Calcium int.
func rd_i64(bs, i) = rd_i64_from(bs, i, signed_byte(bs[i]), 1);

func signed_byte(b) = match b >= 128
    true => b - 256
    false => b;

func rd_i64_from(bs, i, acc, k) = match k >= 8
    true => acc
    false => rd_i64_from(bs, i, acc * 256 + bs[i + k], k + 1);

// rd_f64 rebuilds an IEEE-754 double from sign, exponent and mantissa, because the
// FFI has no "bytes to float" primitive. Subnormals are handled; infinities and
// NaN fall back to 0.0, which no corpus constant needs.
func rd_f64(bs, i) = do
    exp = (bs[i] & 127) * 16 + (bs[i + 1] >> 4);
    mant = rd_mantissa(bs, i);
    magnitude = match exp == 0
        true => mant / 4503599627370496.0 * pow2(-1022)
        false => (1.0 + mant / 4503599627370496.0) * pow2(exp - 1023);
    apply_sign((bs[i] >> 7) & 1, magnitude)
end;

func apply_sign(negative, magnitude) = match negative == 1
    true => 0.0 - magnitude
    false => magnitude;

func rd_mantissa(bs, i) = rd_mantissa_from(bs, i, bs[i + 1] & 15, 2);

func rd_mantissa_from(bs, i, acc, k) = match k >= 8
    true => acc
    false => rd_mantissa_from(bs, i, acc * 256 + bs[i + k], k + 1);

func pow2(n) = match n >= 0
    true => pow2_up(2.0, n, 1.0)
    false => 1.0 / pow2_up(2.0, 0 - n, 1.0);

func pow2_up(base, n, acc) = match n <= 0
    true => acc
    false => pow2_up(base, n - 1, acc * base);

func rd_str(bs, i) = do
    n = rd_u32(bs, i);
    {s: bytes.from_bytes(slice(bs, i + 4, i + 4 + n)), i: i + 4 + n}
end;

func rd_constant(bs, i) = do
    tag = bs[i];
    rest = i + 1;
    rd_constant_tag(bs, tag, rest)
end;

func rd_constant_tag(bs, tag, rest) = match tag
        _TAG_BOOL => {c: CBool(bs[rest] == 1), i: rest + 1}
        _TAG_INT => {c: CInt(rd_i64(bs, rest)), i: rest + 8}
        _TAG_FLOAT => {c: CFloat(rd_f64(bs, rest)), i: rest + 8}
        _TAG_STRING => do
            s1 = rd_str(bs, rest);
            {c: CStr(s1.s), i: s1.i}
        end
        _TAG_FUNCTION => do
            f1 = rd_function(bs, rest);
            {c: CFunc(f1.r), i: f1.i}
        end
        _TAG_REGEX => do
            p2 = rd_str(bs, rest);
            f2 = rd_str(bs, p2.i);
            {c: CRegex(p2.s, f2.s), i: f2.i}
        end
        _TAG_ADT => do
            t3 = rd_str(bs, rest);
            n3 = rd_str(bs, t3.i);
            i3 = rd_constants(bs, n3.i + 4, rd_u32(bs, n3.i), []);
            {c: CAdt(t3.s, n3.s, i3.items), i: i3.i}
        end
        _ => {c: CInt(0), i: len(bs)};

func rd_constants(bs, i, n, acc) = match n <= 0
    true => {items: acc, i: i}
    false => do
        r = rd_constant(bs, i);
        rd_constants(bs, r.i, n - 1, push(acc, r.c))
    end;

func rd_function(bs, i) = do
    name = rd_str(bs, i);
    modid = rd_str(bs, name.i);
    nparams = rd_u32(bs, modid.i);
    ps = rd_params(bs, modid.i + 4, nparams, []);
    locals = rd_u32(bs, ps.i);
    effect = bs[ps.i + 4];
    blen = rd_u32(bs, ps.i + 5);
    body = slice(bs, ps.i + 9, ps.i + 9 + blen);
    {r: FunctionRecord(name.s, modid.s, ps.items, locals, effect == 1, body),
     i: ps.i + 9 + blen}
end;

func rd_params(bs, i, n, acc) = match n <= 0
    true => {items: acc, i: i}
    false => do
        r = rd_str(bs, i);
        rd_params(bs, r.i, n - 1, push(acc, r.s))
    end;
